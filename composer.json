{
    "name": "mata/mata",
    "description": "Mata Monitoring Tool",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "XarcDev",
            "email": "mata@xarc.dev"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "symfony/mailer": "^7.2",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0@dev",
        "bramus/router": "dev-master",
        "league/commonmark": "^2.8@dev",
        "spatie/commonmark-highlighter": "dev-main",
        "vlucas/phpdotenv": "^5.6@dev",
        "twig/twig": "^3.0",
        "robmorgan/phinx": "0.x-dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4@dev",
        "friendsofphp/php-cs-fixer": "^3.89",
        "cyclonedx/cyclonedx-php-composer": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Watcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Watcher\\Tests\\": "src/tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M --level=5",
        "test": "./vendor/bin/phpunit --colors=always ",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    }
}

{
    "name": "mata/mata-dashboard",
    "description": "Self-hosted monitoring dashboard for shared hosting, small VPS and legacy servers: polls MATA nodes, stores metrics and events, and sends alarm emails.",
    "type": "project",
    "keywords": ["monitoring", "dashboard", "alerting", "server-monitoring", "shared-hosting", "htmx", "opa"],
    "homepage": "https://mata.sh",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "XarcDev",
            "email": "mata@xarc.dev"
        }
    ],
    "support": {
        "email": "mata@xarc.dev",
        "docs": "https://mata-sh.github.io/mata-dashboard/",
        "issues": "https://github.com/mata-sh/mata-dashboard/issues",
        "source": "https://github.com/mata-sh/mata-dashboard",
        "security": "https://github.com/mata-sh/mata-dashboard/blob/main/SECURITY.md"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "symfony/mailer": "^7.2",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0",
        "bramus/router": "^1.6",
        "league/commonmark": "^2.8",
        "vlucas/phpdotenv": "^5.6",
        "twig/twig": "^3.0",
        "robmorgan/phinx": "^0.16",
        "mata-sh/rate-limiter": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "friendsofphp/php-cs-fixer": "^3.89",
        "cyclonedx/cyclonedx-php-composer": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Mata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mata\\Tests\\": "src/Tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "stan-entrypoints": "./vendor/bin/phpstan analyse --memory-limit=512M -c phpstan-entrypoints.neon",
        "test": "./vendor/bin/phpunit --colors=always",
        "check": [
            "@lint",
            "@stan",
            "@stan-entrypoints",
            "@test"
        ]
    }
}
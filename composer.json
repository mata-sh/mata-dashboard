{
    "name": "mata/mata-dashboard",
    "description": "Mata Monitoring Tool",
    "type": "project",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "XarcDev",
            "email": "mata@xarc.dev"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "symfony/mailer": "^7.2",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0",
        "bramus/router": "^1.6",
        "league/commonmark": "^2.8",
        "vlucas/phpdotenv": "^5.6",
        "twig/twig": "^3.0",
        "robmorgan/phinx": "^0.16",
        "mata-sh/rate-limiter": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "friendsofphp/php-cs-fixer": "^3.89",
        "cyclonedx/cyclonedx-php-composer": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Mata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mata\\Tests\\": "src/tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M --level=5",
        "stan-entrypoints": "./vendor/bin/phpstan analyse --memory-limit=512M -c phpstan-entrypoints.neon",
        "test": "./vendor/bin/phpunit --colors=always",
        "check": [
            "@lint",
            "@stan",
            "@stan-entrypoints",
            "@test"
        ]
    }
}

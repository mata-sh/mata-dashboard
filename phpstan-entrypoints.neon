# Procedural entrypoints are analysed separately from `src`, but at the same
# level 7 — union types from the C-style stdlib (`fgets`, `readline`,
# `fileowner`) must be guarded here just as they are in `src`.
# Keep entrypoint bootstrapping behind typed factories so PHPStan can follow
# dependencies across file boundaries. Note that PHPStan applies `@param` PHPDoc
# only to named functions, so helpers in these scripts are declared as functions
# rather than closures.
parameters:
    level: 7
    paths:
        - public
        - cron
        - scripts
        - bin/mata
    treatPhpDocTypesAsCertain: false

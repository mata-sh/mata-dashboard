# Procedural entrypoints are analysed separately from level 7 `src`. Level 6
# catches type errors and stale imports; level 7 blockers are tracked in TODO.md.
# Keep entrypoint bootstrapping behind typed factories so PHPStan can follow
# dependencies across file boundaries.
parameters:
    level: 6
    paths:
        - public
        - cron
        - scripts
    treatPhpDocTypesAsCertain: false

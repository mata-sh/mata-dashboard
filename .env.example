# ========================================
# Docker Compose Infrastructure Settings
# ========================================
# This file contains Docker orchestration AND environment-specific settings.
# Application-specific settings (DISPLAY_ERRORS, DOMAIN, etc.) are in config/config.env
#
# Copy this file to .env and configure for your environment

# ========================================
# Environment Configuration
# ========================================
# Application environment: dev, demo, or prod
# Compose reads this value here; guided setup mirrors it to config/config.env
APP_ENV=dev

# ========================================
# Docker Compose Project
# ========================================

# Project name prefix for container names
COMPOSE_PROJECT_NAME=mata-dashboard

# ========================================
# Port Configuration (Decade-Spaced)
# ========================================
# The dashboard defaults to port 3300. Change it when another service uses it.

# Dashboard web interface (maps to container port 80)
WEB_PORT=3300

# Open Policy Agent host port (development only, bound to 127.0.0.1)
OPA_PORT=3320

# MySQL host port (development only, bound to 127.0.0.1; not exposed in production)
MYSQL_PORT=3306

# Build pins for the Docker images (must be concrete tags, not floating ones)
PHP_VERSION=8.3.14
COMPOSER_VERSION=2.7.9

# ========================================
# Database Container Settings
# ========================================
# MySQL root password for container initialization
# IMPORTANT: Change this to a secure value before deploying
MYSQL_ROOT_PASSWORD=change_me_in_production

# NOTE: the MySQL container is initialized from DB_DATABASE / DB_USERNAME /
# DB_PASSWORD (docker-compose.yml maps them to MYSQL_DATABASE / MYSQL_USER /
# MYSQL_PASSWORD). Set those in config/db.config.env, NOT here.
#
# Compose can interpolate them from that file only because every invocation passes
# both env files, in this order:
#
#   docker compose --env-file config/db.config.env --env-file .env ...
#
# The Makefile does this for you (COMPOSE_ENV_FILES, Makefile:22). A bare
# `docker compose up` omits it, and the DB_* values then resolve to nothing - which
# is why the passwords below are declared required rather than defaulted. Always go
# through make, or pass both --env-file flags yourself.
#
# Do not also set DB_* here: later --env-file entries win, so a stale copy in this
# file would silently override config/db.config.env.

# Production MySQL bind-mount root (relative paths resolve from this repository)
DATA_PATH=./data

# MySQL Performance Tuning
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=200

# ========================================
# Production Deployment Notes
# ========================================
# 1. Set a strong MYSQL_ROOT_PASSWORD here, and a strong DB_PASSWORD in BOTH this
#    file and config/db.config.env - the two must stay identical (see above)
# 2. Set APP_ENV=prod here; guided setup keeps config/config.env in sync
# 3. Configure application settings in config/config.env.
# 4. Use Docker secrets for sensitive data in production environments

# Docker Compose Environment Variables
# Copy this file to .env and configure for your environment
#
# IMPORTANT: This file contains Docker orchestration settings only.
# Application-specific settings are in config/*.env files (config.env, db.config.env, mail.config.env)

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=mata-dashboard

# Build Configuration
BUILD_DATE=2024-01-01T00:00:00Z
VERSION=latest

# Application Environment (demo, dev, prod)
# This controls which config/{env}/ directory is loaded for JSON configs
APP_ENV=demo
WEB_PORT=8080

# Database Configuration (for docker-compose services)
DB_HOST=mata-db
DB_PORT=3306
DB_DATABASE=mata_dashboard
DB_USERNAME=mata_user
DB_PASSWORD=change_me_in_production
MYSQL_ROOT_PASSWORD=change_me_in_production

# PHP Settings (override for specific environments)
DISPLAY_ERRORS=0
LOG_LEVEL=errors
TEMPLATE_DEBUG_ENABLED=false

# Data Storage Path (optional - for bind mounts)
DATA_PATH=./data

# MySQL Performance Tuning
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=200

# Production Deployment Notes:
# 1. Change all passwords to strong, unique values
# 2. Set APP_ENV=prod for production
# 3. Set DISPLAY_ERRORS=0 and LOG_LEVEL=errors for production
# 4. Use Docker secrets or environment-specific .env files for sensitive data
# 5. Consider using a .env.dev and .env.prod pattern with docker-compose
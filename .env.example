# ========================================
# Docker Compose Infrastructure Settings
# ========================================
# This file contains ONLY Docker orchestration settings.
# Application settings (APP_ENV, DISPLAY_ERRORS, etc.) are in config/config.env
#
# Copy this file to .env and configure for your environment

# ========================================
# Docker Compose Project
# ========================================

# Project name prefix for container names
COMPOSE_PROJECT_NAME=mata-dashboard

# ========================================
# Port Configuration (Decade-Spaced)
# ========================================
# Uses decade spacing (3300, 3310, 3320...) for clean separation
# Allows room for expansion (e.g., 3301-3309 reserved for dashboard features)
# Multiple stacks can use 3400, 3410, 3420... to avoid conflicts

# Dashboard web interface (maps to container port 80)
WEB_PORT=3300

# Node API endpoint (for local node testing)
NODE_PORT=3310

# Open Policy Agent service
OPA_PORT=3320

# MkDocs documentation server (development only)
MKDOCS_PORT=3330

# MySQL database (standard port, not exposed externally in production)
MYSQL_PORT=3306

# PHP version to use in Docker images
PHP_VERSION=8.3

# ========================================
# Database Container Settings
# ========================================
# MySQL root password for container initialization
# IMPORTANT: Change this to a secure value before deploying
# NOTE: Application DB credentials (DB_USERNAME, DB_PASSWORD, etc.) are in config/db.config.env
MYSQL_ROOT_PASSWORD=change_me_in_production

# MySQL Performance Tuning
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=200

# ========================================
# Production Deployment Notes
# ========================================
# 1. Change DB_PASSWORD and MYSQL_ROOT_PASSWORD to strong, unique values
# 2. Set application environment in config/config.env (APP_ENV=prod)
# 3. Configure application settings in config/config.env (DOMAIN, WATCHER_ENCRYPTION_SECRET, etc.)
# 4. Use Docker secrets for sensitive data in production environments

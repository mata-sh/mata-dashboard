<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>{{ branding }} — {{ alarm.type }}</title>
    <!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
    <style>
        body { margin:0; padding:0; }
        a { text-decoration:none; }
        @media only screen and (max-width: 640px) {
            .container { width:100% !important; }
            .px { padding-left:20px !important; padding-right:20px !important; }
            .metric-cell { display:block !important; width:100% !important; box-sizing:border-box; border-right:0 !important; }
            .metric-cell + .metric-cell { border-top:1px solid #1d2632; }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#000000; color:#e8eef5; -webkit-text-size-adjust:100%;">
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ severity.display_label|upper }} · {{ target.server }}{% if presentation.metric %} · {{ presentation.metric.value }} {{ presentation.metric.label|lower }}{% endif %} · Alarm #{{ alarm.id }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#000000;"><tr><td align="center" style="padding:32px 12px;">
<table role="presentation" class="container" width="625" cellpadding="0" cellspacing="0" border="0" style="width:625px; max-width:625px;">
    <tr><td style="padding:0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
            <td width="8" style="background-color:{{ severity.accent }}; font-size:0; line-height:0;">&nbsp;</td>
            <td style="background-color:#0d1117; padding:14px 24px; border-top:1px solid #1d2632; border-right:1px solid #1d2632; border-bottom:1px solid #1d2632;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                    <td style="font-family:Consolas,'Courier New',monospace; font-size:12px; letter-spacing:3px; color:#3fd0e0; text-transform:uppercase;">{{ branding }}<span style="color:#2a3644;">://</span>monitoring</td>
                    <td></td>
                </tr></table>
            </td>
        </tr></table>
    </td></tr>
    <tr><td style="background-color:#0d1117; border-left:1px solid #1d2632; border-right:1px solid #1d2632; border-bottom:1px solid #1d2632;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="px" style="padding:32px 32px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                {% if not target.is_server_only %}<td style="background-color:#111823; padding:4px 12px; font-family:Arial,Helvetica,sans-serif; font-size:26px; line-height:34px; font-weight:bold; color:#ffffff; text-transform:uppercase; border:1px solid #1d2632;">{{ target.app }}</td>{% endif %}
                <td style="background-color:{{ target.color|default('#2a3644') }}; padding:4px 12px; font-family:Arial,Helvetica,sans-serif; font-size:26px; line-height:34px; font-weight:bold; color:#ffffff; text-transform:uppercase; text-align:center;">{{ target.server }}</td>
            </tr></table>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="padding-top:20px;"><tr>
                <td style="border:1px solid {{ severity.accent }}; padding:5px 12px; font-family:Consolas,'Courier New',monospace; font-size:12px; letter-spacing:4px; color:{{ severity.accent }}; text-transform:uppercase;">▲ {{ severity.display_label }}</td>
                {% if target.environment %}<td width="8" style="width:8px; font-size:0; line-height:0;">&nbsp;</td><td style="border:1px solid {{ target.environment.badgeColor }}; padding:5px 12px; font-family:Consolas,'Courier New',monospace; font-size:12px; letter-spacing:4px; color:{{ target.environment.badgeColor }}; text-transform:uppercase; filter:brightness(1.15);">{{ target.environment.label }}</td>{% endif %}
                <td style="padding-left:12px; font-family:Consolas,'Courier New',monospace; font-size:12px; letter-spacing:2px; color:#72849b;">{{ severity.code }} · ALARM #{{ alarm.id }}</td>
            </tr></table>
            <div style="font-family:Arial,Helvetica,sans-serif; font-size:18px; line-height:27px; color:#8a99ad; padding-top:8px; padding-bottom:28px;">{{ presentation.description }}</div>
        </td></tr></table>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="px" style="padding:0 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #1d2632; background-color:#0a0e14;"><tr>
                {% if presentation.metric %}
                <td class="metric-cell" width="50%" style="padding:20px 24px; border-right:1px solid #1d2632;">
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:11px; font-weight:bold; letter-spacing:2px; color:#718399; text-transform:uppercase;">{{ presentation.metric.label }}</div>
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:40px; line-height:48px; color:{{ severity.accent }}; padding-top:6px;">{{ presentation.metric.value }}</div>
                    {% if presentation.metric.threshold %}<div style="font-family:Consolas,'Courier New',monospace; font-size:17px; line-height:24px; color:#72849b; padding-top:4px;">{{ presentation.metric.threshold }}</div>{% endif %}
                </td>
                {% endif %}
                <td class="metric-cell"{% if presentation.metric %} width="50%"{% endif %} style="padding:20px 24px;">
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:11px; letter-spacing:3px; color:#72849b; text-transform:uppercase;">last_seen</div>
                    {% if alarm.last_seen_at %}
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:16px; line-height:24px; color:#e8eef5; padding-top:10px;">{{ alarm.last_seen_at }}</div>
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:12px; color:#3fd0e0; padding-top:8px;">&#9679; {{ alarm.last_seen_ago }}</div>
                    {% else %}
                    <div style="font-family:Consolas,'Courier New',monospace; font-size:16px; line-height:24px; color:#e8eef5; padding-top:10px;">NO PREVIOUS ALARM</div>
                    {% endif %}
                </td>
            </tr></table>
        </td></tr></table>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="px" style="padding:24px 32px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0a0e14; border:1px solid #1d2632;"><tr><td style="padding:10px 16px; border-bottom:1px solid #1d2632; font-family:Consolas,'Courier New',monospace; font-size:14px; letter-spacing:2px; color:#3fd0e0;">&gt;_ alarm.context</td></tr><tr><td style="padding:16px; font-family:Consolas,'Courier New',monospace; font-size:16px; line-height:28px; white-space:pre-wrap;"><span style="display:inline-block; width:140px; color:#72849b;">server:</span> <span style="color:#e8eef5;">{{ target.server }}</span><br><span style="display:inline-block; width:140px; color:#72849b;">application:</span> <span style="color:#e8eef5;">{{ target.app }}</span><br><span style="display:inline-block; width:140px; color:#72849b;">type:</span> <span style="color:{{ severity.accent }};">{{ alarm.type }}</span><br><span style="display:inline-block; width:140px; color:#72849b;">alarm_id:</span> <span style="color:#e8eef5;">{{ alarm.id }}</span><br><span style="display:inline-block; width:140px; color:#72849b;">context:</span><br><span style="color:#8a99ad;">{{ alarm.context }}</span></td></tr></table>
        </td></tr></table>

        {% if dashboard_url %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="px" align="left" style="padding:28px 32px 32px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background-color:{{ severity.accent }}; border:1px solid {{ severity.accent }};"><a href="{{ dashboard_url }}" style="display:inline-block; padding:14px 32px; font-family:Consolas,'Courier New',monospace; font-size:13px; font-weight:bold; letter-spacing:3px; color:#07090e; text-transform:uppercase; text-decoration:none;">Open dashboard →</a></td></tr></table></td></tr></table>{% endif %}
    </td></tr>
    <tr><td style="padding:16px 8px;"><div style="font-family:Consolas,'Courier New',monospace; font-size:11px; line-height:18px; letter-spacing:1px; color:#3a4656; text-align:center;">transmission by {{ branding }} monitoring</div></td></tr>
</table>
</td></tr></table>
</body>
</html>

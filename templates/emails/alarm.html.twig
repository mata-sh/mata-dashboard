<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ severity.display_label }} alarm</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;color:#111827;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background-color:#f3f4f6;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border-collapse:collapse;">
                <tr>
                    <td style="padding:18px 24px;background-color:#111827;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:0.02em;">{{ branding }}</td>
                </tr>
                <tr>
                    <td style="height:6px;background-color:{{ severity.accent }};font-size:0;line-height:0;">&nbsp;</td>
                </tr>
                <tr>
                    <td style="padding:28px 24px 24px;">
                        <span style="display:inline-block;padding:5px 9px;background-color:{{ severity.background }};color:{{ severity.accent }};font-size:12px;font-weight:700;letter-spacing:0.08em;line-height:1.2;text-transform:uppercase;">{{ severity.emoji }} {{ severity.display_label }}</span>
                        <div style="margin:18px 0 24px;font-size:24px;font-weight:700;line-height:1.35;white-space:pre-wrap;">{{ alarm.message }}</div>
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;font-size:14px;line-height:1.45;">
                            <tr><td style="width:34%;padding:8px 10px 8px 0;border-bottom:1px solid #e5e7eb;color:#6b7280;font-weight:700;">Server</td><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;">{{ target.server }}</td></tr>
                            <tr><td style="width:34%;padding:8px 10px 8px 0;border-bottom:1px solid #e5e7eb;color:#6b7280;font-weight:700;">Application</td><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;">{{ target.app }}</td></tr>
                            <tr><td style="width:34%;padding:8px 10px 8px 0;border-bottom:1px solid #e5e7eb;color:#6b7280;font-weight:700;">Type</td><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;">{{ alarm.type }}</td></tr>
                            <tr><td style="width:34%;padding:8px 10px 8px 0;border-bottom:1px solid #e5e7eb;color:#6b7280;font-weight:700;">Alarm ID</td><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;">{{ alarm.id }}</td></tr>
                            <tr><td style="width:34%;padding:8px 10px 8px 0;color:#6b7280;font-weight:700;">Created</td><td style="padding:8px 0;">{{ alarm.created_at }}</td></tr>
                        </table>
                        <div style="margin-top:24px;color:#374151;font-size:14px;font-weight:700;">Context</div>
                        <div style="margin-top:8px;padding:12px;background-color:#f9fafb;border:1px solid #e5e7eb;color:#1f2937;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;line-height:1.5;white-space:pre-wrap;">{{ alarm.context ?: 'No additional context' }}</div>
                        {% if dashboard_url %}
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:24px;"><tr><td style="background-color:{{ severity.accent }};"><a href="{{ dashboard_url }}" style="display:inline-block;padding:11px 16px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;">Open dashboard</a></td></tr></table>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px;background-color:#f9fafb;color:#6b7280;font-size:12px;line-height:1.5;">This message was generated by MATA monitoring.</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>

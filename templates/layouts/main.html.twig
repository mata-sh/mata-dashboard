<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ branding.app_name }} - Dashboard</title>
    {% include "partials/structure/head.html.twig" %}
</head>
<body>
    {% include "partials/components/progress-bar.html.twig" %}
    {% block content %}{% endblock %}
    {% include "partials/structure/footer.html.twig" %}

    <div id=modal-container
    class="modal modal-blur fade"
    aria-hidden="false"
    tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content"></div>
        </div>
    </div>

    <div id="message-modal" class="modal mata-message-modal" role="dialog" aria-modal="true" aria-labelledby="message-modal-title" aria-hidden="true" hidden>
        <div class="modal-background" data-message-modal-close></div>
        <div class="modal-content box" role="document">
            <div class="message-modal__header">
                <h2 id="message-modal-title">Full message</h2>
                <button type="button" class="message-modal__close" aria-label="Close full message" data-message-modal-close>&times;</button>
            </div>
            <pre id="message-modal-content" class="message-modal__content"></pre>
        </div>
    </div>

</body>
</html>

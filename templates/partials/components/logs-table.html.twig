<div class="logs-section">
    <div class="filter-menu">
        <input id="filter-time" type="text" placeholder="2025.05.08 20:00:00">

    <select id="filter-type">
            <option value="">All Types</option>
            <option value="Error">Error</option>
            <option value="Warning">Warning</option>
            <option value="Deprecated">Deprecated</option>
            <option value="Other">Other</option>
        </select>

        <input id="filter-source" type="text" placeholder="Source file">

        <input id="filter-msg" type="text" placeholder="Message">

        <button class="button" id="filter-clear">Clear Filter</button>
    </div>
    
    <div id="logs-table" data-logs-url="{{ endpoints.app_logs_json }}"></div>
</div>

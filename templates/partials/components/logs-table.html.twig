<div class="logs-section">
    <h3>Logs</h3>

    <div class="filter-menu">
        <input id="filter-time" type="text" placeholder="2025.05.08 20:00:00">

    <select id="filter-type">
            <option value="">All Types</option>
            <option value="Error">Error</option>
            <option value="Warning">Warning</option>
            <option value="Deprecated">Deprecated</option>
            <option value="Other">Other</option>
        </select>

        <input id="filter-source" type="text" placeholder="Source file">

        <input id="filter-msg" type="text" placeholder="Message">

        <button class="button" id="filter-clear">Clear Filter</button>
    </div>
    
    <div id="logs-table"></div>
</div>

<script>

var table = new Tabulator("#logs-table", {
    ajaxURL: "{{ endpoints.app_logs_json }}",
    // layout: "fitColumns",
    layout:"fitDataFill",
    height:"1200px",
    pagination: "local",
    // paginationSize: 10,
    paginationSize:33,
    columns: [
        {title: "Timestamp", field: "timestamp", sorter: "datetime", hozAlign:"center", width: 180},
        {title:"Type", field:"type", hozAlign:"center", width: 120, formatter:function(cell, formatterParams){
        // {title: "Level", field: "level", sorter: "string",hozAlign:"center"},
        var value = cell.getValue();
            switch (value) {
                case "Error":
                    return `<span style='color:red; font-weight:bold;'>${value}</span>`;
                case "Warning":
                    return `<span style='color:orange; font-weight:bold;'>${value}</span>`;
                case "Deprecated":
                    return `<span style='color:#3FB449; font-weight:bold;'>${value}</span>`;
                default:
                    return value;
            }

        }},
        {title: "Source", field: "source", sorter: "string", hozAlign:"left", width: 250},
        {title: "Message", field: "message", sorter: "string"}
    ],
});

Tabulator.extendModule("filter", "filters", {
    "===":function(headerValue, rowValue, rowData, filterParams){
        //headerValue - the value of the header filter element
        //rowValue - the value of the column in this row
        //rowData - the data for the row being filtered
        //filterParams - params object passed to the headerFilterFuncParams property

        return rowValue === headerValue ? true : false;
    }
});


/* --- helper that reads the inputs and applies all active filters in one call --- */
function applyFilters(){
    const filters = [];
    const typeVal   = document.getElementById("filter-type").value;
    const sourceVal = document.getElementById("filter-source").value.trim();
    const msgVal    = document.getElementById("filter-msg").value.trim();
    const timeVal   = document.getElementById("filter-time").value.trim();

    if(typeVal)   filters.push({field:"type",      type:"=",    value:typeVal});
    if(sourceVal) filters.push({field:"source",    type:"like", value:sourceVal});
    if(msgVal)    filters.push({field:"message",   type:"like", value:msgVal});
    if(timeVal)   filters.push({field:"timestamp", type:"like", value:timeVal});

    table.setFilter(filters);               // one hit, zero fuss
}

/* --- wire the UI --- */
["filter-time","filter-source","filter-msg"].forEach(id=>{
    document.getElementById(id).addEventListener("input", applyFilters);
});
document.getElementById("filter-type").addEventListener("change", applyFilters);

/* === update Clear button === */
document.getElementById("filter-clear").addEventListener("click", () => {
    ["filter-type","filter-time","filter-source","filter-msg"].forEach(id=>{
        document.getElementById(id).value = "";
    });
    document.getElementById("filter-type").value = "";
    table.clearFilter();
});
</script>

<div class="app-container">
  <span class="app-ping {{ app.ping }}" data-tippy-content="{{ app.ping_latency }}"></span>
  <span class="app-title">
    <span class="app-name" data-tippy-content="{{ app.title_tooltip }}">{{ app.name }}</span>
    <a class="app-url-btn" href="{{ app.url }}" target="_blank" data-tippy-content="{{ app.url_tooltip }}">{{ icons.link|raw }}</a>
    {# <!--  <a class="app-refresh-btn htmx-indicator"  
           hx-get="/watch/refresh/app" 
           hx-target="#app-status-{{ app.id }}" hx-swap="innerHTML"
           data-tippy-content="Refresh {{ app.name }}">
            {{ icons.refresh_ccw|raw }}
        </a>  --> #}
    <button type="button" class="app-readme-btn modal-trigger" aria-label="Open application README" aria-haspopup="dialog" hx-get="{{ endpoints.modal_app_readme_render }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.info|raw }}</button>
  </span>
  {# <!--  <span class="app-libs {{ APP_ENV }}" data-tippy-content="{{ APP_PATH }}">
        <span class="libs-helper">2.0.9.2</span>
        <span class="libis-security">2.0.6.0</span>        
    </span>  --> #}
  <span class="app-env {{ app.env }}" data-tippy-content="{{ app.path_tooltip }}">{{ app.env }}</span>
  {% if app.status_clickable %}
    <span id="app-status-{{ app.id }}" class="app-status" data-tippy-content="{{ app.status_tooltip }}" hx-get="{{ endpoints.modal_app_logs_render }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">
  {% else %}
    <span id="app-status-{{ app.id }}" class="app-status" data-tippy-content="{{ app.status_tooltip }}">
  {% endif %}
    <span class="app-status-count {{ app.status_type }}">
      {% if app.status_count %}
        {{ app.status_count }}
      {% else %}
        {{ icons.check_circle|raw }}
      {% endif %}
    </span>
    <span class="app-status-text {{ app.status_type }}">{{ app.status_type }}</span>
  </span>
  {% if logs.file_size_clickable %}
    <button type="button" class="app-filesize count {{ logs.file_size_level }} modal-trigger" aria-label="Open error log file details" aria-haspopup="dialog" data-tippy-content="{{ logs.file_size_tooltip }}" hx-get="{{ endpoints.modal_app_log_files_render }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ logs.max_file_size }} {{ icons.alert|raw }}</button>
  {% else %}
    <span class="app-filesize count" data-tippy-content="{{ logs.file_size_tooltip }}">{{ logs.max_file_size }}</span>
  {% endif %}
  <span class="app-sessions count {{ sessions.count_level }}" data-tippy-content="{{ sessions.tooltip }}">{{ sessions.count_last }} {{ icons.user|raw }}</span>
</div>

<div id="server-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title" data-tippy-content="Server Updated: {{ server.cache_age }} s ago (TTL: {{ server.cache_ttl }} s)">
      {{ server.title }}
      <a class="server-refresh-btn" data-tippy-content="Refresh Server">{{ icons.refresh_ccw|raw }}</a>
    </h3>
  </div>

  <div class="sqlstats-container">
    SQL Processes: {{ system.processes_sql ?? '–' }}
  </div>

{% if not_configured %}
  <div class="db-row-empty">Database monitoring is not configured on this node.</div>
{% elseif overview %}
  <div class="sqlstats-container db-row">
    <span class="app-title">{{ icons.database|raw }} {{ overview.engine }}</span>
    <span class="db-endpoint" data-tippy-content="Server uptime">up {{ overview.uptime }}</span>
    <span class="db-metric" data-tippy-content="Connections / max connections">
      {{ overview.connections }} <em>/ {{ overview.max_connections }}</em>
    </span>
    <span class="db-metric" data-tippy-content="Running threads">{{ overview.running }} <em>run</em></span>
    <button type="button" class="db-metric db-process-list modal-trigger" aria-label="Open process list for all monitored databases" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ overview.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
    <span class="db-status is-ok" role="img" aria-label="Database server OK" data-tippy-content="Connected">{{ icons.check_circle|raw }}</span>
  </div>
  {% if overview.details %}
    <div class="db-row-note">{{ overview.details }}</div>
  {% endif %}
  {% for db in overview.databases %}
    <div class="sqlstats-container db-row">
      <span class="app-title">{{ icons.database|raw }} {{ db.name }}</span>
      <span class="db-endpoint">{{ db.description }}</span>
      <span></span>
      <span></span>
      <button type="button" class="db-metric db-process-list modal-trigger" aria-label="Open process list for {{ db.name }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ db.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
      <span></span>
    </div>
  {% endfor %}
{% endif %}

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

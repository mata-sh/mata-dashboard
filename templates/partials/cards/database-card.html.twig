<div id="database-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title"{% if server.cache_age is not null %} data-tippy-content="Server Updated: {{ server.cache_age }} ago (TTL: {{ server.cache_ttl }})"{% endif %}>
      {{ server.title }}
      <button type="button" class="server-refresh-btn" aria-label="Refresh databases" data-tippy-content="Refresh Databases" hx-swap="outerHTML" hx-target="#database-{{ server.id }}" hx-get="{{ server.refresh_url }}">{{ icons.refresh_ccw|raw }}</button>
    </h3>
    <span>SQL Processes: {{ system.processes_sql ?? '–' }}</span>
  </div>

{% if not_configured %}
  <div class="db-row-empty">Database monitoring is not configured on this node.</div>
{% elseif overview %}
  {% for connection in overview.connections %}
    <section class="db-connection{% if connection.error %} is-down{% endif %}" aria-label="Connection {{ connection.connection }}">
      <div class="db-connection-head">
        <span class="db-connection-state" aria-hidden="true"></span>
        <strong class="db-connection-name">{{ connection.connection }}</strong>
        <span class="db-engine">{{ connection.engine }}</span>
        {% if connection.error %}
          <span class="db-connection-error">{{ connection.error.message }}</span>
        {% else %}
          <span class="db-connection-stats">{{ connection.connections }} / {{ connection.max_connections }} connections · {{ connection.running }} running · up {{ connection.uptime }}</span>
          {% if connection.details %}<span class="db-connection-details">{{ connection.details }}</span>{% endif %}
        {% endif %}
        <button type="button" class="db-process-list modal-trigger" aria-label="Open process list for connection {{ connection.connection }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ connection.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
      </div>
      <ul class="db-list">
        {% for db in connection.databases %}
          <li class="db-item">
            <span class="db-name">{{ icons.database|raw }}<span>{{ db.name }}</span></span>
            <span class="db-description">{{ db.description }}</span>
            <button type="button" class="db-process-list modal-trigger" aria-label="Open process list for {{ connection.connection }} / {{ db.name }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ db.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
{% endif %}

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

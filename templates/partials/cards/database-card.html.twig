<div id="server-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title" data-tippy-content="Server Updated: {{ server.cache_age }} s ago (TTL: {{ server.cache_ttl }} s)">
      {{ server.title }}
      <a class="server-refresh-btn" data-tippy-content="Refresh Server">{{ icons.refresh_server|raw }}</a>
    </h3>
  </div>

  <div class="sqlstats-container">
    <span class=""></span>

    Uptime: 72:20:46 | since 05.05.2025 - 12:45:22
    <!-- Last Restart Time: <br><br> -->
    Table Size: <br />
    Slow Query Count:<br />
    Queries per Second:<br />
    Temporary Tables Created: <br />
    SQL Processes: {{ system.processes_sql }}<br /><br />
    Max Used Connections<br />
    Current Connections<br />
    Threads Connected<br />
    Threads Running<br />
    Threads Created (since startup)<br />
    Threads Cached<br />
  </div>

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

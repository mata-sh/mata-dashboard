<div id="database-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title"{% if server.cache_age is not null %} data-tippy-content="Server Updated: {{ server.cache_age }} ago (TTL: {{ server.cache_ttl }})"{% endif %}>
      {{ server.title }}
      <button type="button" class="server-refresh-btn" aria-label="Refresh databases" data-tippy-content="Refresh Databases" hx-swap="outerHTML" hx-target="#database-{{ server.id }}" hx-get="{{ server.refresh_url }}">{{ icons.refresh_ccw|raw }}</button>
    </h3>
    <span>SQL Processes: {{ system.processes_sql ?? '–' }}</span>
  </div>

{% if not_configured %}
  <div class="db-row-empty">Database monitoring is not configured on this node.</div>
{% elseif overview %}
  {% for connection in overview.connections %}
    <div class="sqlstats-container">
      <strong>{{ connection.connection }}</strong> · {{ connection.engine }} ·
      {% if connection.error %}
        <span class="server-fetch-error">{{ connection.error.message }}</span>
      {% else %}
        {{ connection.connections }} / {{ connection.max_connections }} connections · {{ connection.running }} run · up {{ connection.uptime }}
        {% if connection.details %} · {{ connection.details }}{% endif %}
      {% endif %}
      <button type="button" class="db-process-list modal-trigger" aria-label="Open process list for connection {{ connection.connection }}" aria-haspopup="dialog" hx-get="{{ connection.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
    </div>
  {% endfor %}
  <div class="sqlstats-container db-row">
    <strong>Database</strong><strong>Description</strong><strong>Engine</strong><strong>Connection</strong><span></span><span></span>
  </div>
  {% for db in overview.databases %}
    <div class="sqlstats-container db-row">
      <span class="app-title">{{ icons.database|raw }} {{ db.name }}</span>
      <span class="db-endpoint">{{ db.description }}</span>
      <span>{{ db.engine }}</span>
      <span>{{ db.connection }}</span>
      <button type="button" class="db-metric db-process-list modal-trigger" aria-label="Open process list for {{ db.connection }} / {{ db.name }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ db.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
      <span>{% if db.error %}{{ db.error.message }}{% endif %}</span>
    </div>
  {% endfor %}
{% endif %}

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

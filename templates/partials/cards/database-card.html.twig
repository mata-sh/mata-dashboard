<div id="server-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title" data-tippy-content="Server Updated: {{ server.cache_age }} s ago (TTL: {{ server.cache_ttl }} s)">
      {{ server.title }}
      <a class="server-refresh-btn" data-tippy-content="Refresh Server">{{ icons.refresh_ccw|raw }}</a>
    </h3>
  </div>

  <div class="sqlstats-container">
    SQL Processes: {{ system.processes_sql }}
  </div>

{% if databases_available %}
  {% for db in databases %}
    <div class="sqlstats-container db-row">
      <span class="app-title" {% if db.configured_database %}data-tippy-content="configured as {{ db.configured_database }}"{% endif %}>
        {{ icons.database|raw }} {{ db.name }}
      </span>
      <span class="db-endpoint" {% if db.description %}data-tippy-content="{{ db.description }}"{% endif %}>{{ db.endpoint }}</span>
      <span class="db-metric" data-tippy-content="Active processes / max connections">
        {{ db.active_processes ?? '–' }} / {{ db.max_connections ?? '–' }}
      </span>
      <span class="db-metric" data-tippy-content="Active threads">{{ db.active_threads ?? '–' }} thr</span>
      <span class="db-metric" data-tippy-content="Process list entries">{{ db.process_count }} {{ icons.activity|raw }}</span>
      <span class="tag is-light {{ db.status == 'ok' ? 'is-success' : 'is-danger' }}" data-tippy-content="{{ db.status_tooltip }}">
        {% if db.status == 'ok' %}{{ icons.check_circle|raw }} OK{% else %}{{ icons.alert|raw }} ERR{% endif %}
      </span>
    </div>
  {% endfor %}
{% else %}
  <div class="db-row-empty">Per-database status not reported by this node.</div>
{% endif %}

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

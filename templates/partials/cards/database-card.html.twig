<div id="database-{{ server.id }}" class="database-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title"{% if server.cache_age is not null %} data-tippy-content="Server Updated: {{ server.cache_age }} ago (TTL: {{ server.cache_ttl }})"{% endif %}>
      {{ server.title }}
      <button type="button" class="server-refresh-btn" aria-label="Refresh databases" data-tippy-content="Refresh Databases" hx-swap="outerHTML" hx-target="#database-{{ server.id }}" hx-get="{{ server.refresh_url }}">{{ icons.refresh_ccw|raw }}</button>
    </h3>
    <span>SQL Processes: {{ system.processes_sql ?? '–' }}</span>
  </div>

{% if not_configured %}
  <div class="db-row-empty">Database monitoring is not configured on this node.</div>
{% elseif overview %}
  {% for connection in overview.connections %}
    <details class="db-connection{% if connection.error %} is-down{% endif %}" data-collapse-key="{{ server.id }}/{{ connection.connection }}" open>
      <summary class="db-connection-head" aria-label="Connection {{ connection.connection }}, {{ connection.error ? 'failed' : 'online' }}">
        <span class="db-connection-toggle" aria-hidden="true">{{ icons.chevron|raw }}</span>
        <span class="db-connection-state" aria-hidden="true"></span>
        <strong class="db-connection-name" data-tippy-content="{{ connection.databases|length }} monitored database{{ connection.databases|length == 1 ? '' : 's' }}">{{ connection.connection }}</strong>
        <span class="db-engine">{{ connection.engine }}</span>
        {% if connection.error %}
          <span class="db-connection-error">{{ icons.alert|raw }} {{ connection.error.message }}</span>
        {% else %}
          <span class="db-stats">
          <span class="db-stat" data-tippy-content="Open connections / max_connections">
            <span class="db-stat-label">Conn</span>
            <span class="db-stat-value">{{ connection.connections }} <em>/ {{ connection.max_connections }}</em></span>
            <span class="db-usage" aria-hidden="true"><span style="width: {{ connection.usage_percent }}%"></span></span>
          </span>
          <span class="db-stat" data-tippy-content="Queries running right now">
            <span class="db-stat-label">Running</span><span class="db-stat-value">{{ connection.running }}</span>
          </span>
          <span class="db-stat" data-tippy-content="Database server uptime">
            <span class="db-stat-label">Up</span><span class="db-stat-value">{{ connection.uptime }}</span>
          </span>
          {% for stat in [
            {label: 'Peak', value: connection.peak, tip: 'Most connections at once since start'},
            {label: 'Refused', value: connection.refused, tip: 'Connections refused at the limit since start'},
            {label: 'Aborted', value: connection.aborted, tip: 'Failed connection attempts since start'},
          ] %}
            {% if stat.value is null %}
              <span class="db-stat is-empty"></span>
            {% else %}
              <span class="db-stat" data-tippy-content="{{ stat.tip }}">
                <span class="db-stat-label">{{ stat.label }}</span><span class="db-stat-value">{{ stat.value }}</span>
              </span>
            {% endif %}
          {% endfor %}
          </span>
        {% endif %}
        <button type="button" class="db-process-list modal-trigger" aria-label="Open process list for connection {{ connection.connection }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ connection.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
      </summary>
      <ul class="db-list">
        {% for db in connection.databases %}
          <li class="db-item">
            <span class="db-name">{{ icons.database|raw }}<span>{{ db.name }}</span></span>
            <span class="db-description">{{ db.description }}</span>
            <button type="button" class="db-process-list modal-trigger" aria-label="Open process list for {{ connection.connection }} / {{ db.name }}" aria-haspopup="dialog" data-tippy-content="Process list" hx-get="{{ db.process_modal_url }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.activity|raw }}</button>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endfor %}
{% endif %}

  <br />
  {{ content.apps_status|raw }}

  {% if ui.error_message %}
    <div class="server-fetch-error">{{ ui.error_message }}</div>
  {% endif %}
</div>

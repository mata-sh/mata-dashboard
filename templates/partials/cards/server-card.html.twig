<div id="server-{{ server.id }}" class="server-container">
  <div class="server-header" style="border-color: {{ server.primary_color }}">
    <h3 class="server-title" data-tippy-content="Server Updated: {{ cache.age }} s ago (TTL: {{ cache.ttl }} s)">
      {{ server.title }}
      <span class="node-health-status node-health-{{ server.health.state }}" data-tippy-content="{{ server.health.tooltip }}">{{ server.health.label }}</span>
      <button type="button" class="server-info-btn modal-trigger" aria-label="Open server information" aria-haspopup="dialog" hx-get="{{ endpoints.modal_server_info_render }}" hx-target="#modal-container" hx-trigger="click" hx-toggle="modal">{{ icons.info|raw }}</button>
      <button type="button" class="server-refresh-btn" aria-label="Refresh server" data-tippy-content="Refresh Server" hx-swap="innerHTML" hx-target="#server-{{ server.id }}" hx-get="/watch/refresh/server/{{ server.name }}">{{ icons.refresh_ccw|raw }}</button>
    </h3>
    {% include 'partials/cards/server-stats.html.twig' %}
  </div>
  {{ content.apps_status|raw }}
  {% if error.message is defined %}
    <div class="server-fetch-error">{{ error.message }}</div>
  {% endif %}
</div>

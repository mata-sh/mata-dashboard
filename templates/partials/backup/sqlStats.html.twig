
<section class="section">
    <div class="container sql">
        <div class="sql-stats sql-connections">
            <span class="sql-label">
                Connections
            </span> 
            <span class="sql-active">{{ ACTIVE_SQL_CONNECTIONS }}</span> / 
            <span class="sql-max">{{ MAX_CONNECTIONS }}</span>
        </div>

        <div class="sql-stats sql-threads">
            <span class="sql-label">
                Threads
            </span> 
            <span class="sql-active">{{ ACTIVE_SQL_CONNECTIONS }}</span> 
        </div>

    </div>
</section>
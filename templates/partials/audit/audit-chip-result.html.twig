{% if error %}
  <span class="audit-chip chip-error" data-tippy-content="{{ message }}">{{ server }}/{{ app }} · error</span>
{% else %}
  <span class="audit-chip done sev-{{ worst_severity ?? 'none' }}">{{ server }}/{{ app }} · {% if total > 0 %}{{ total }} vulns{% else %}<svg class="audit-clean-icon" viewBox="0 0 24 24" role="img" aria-label="No vulnerabilities" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>{% endif %}{% if total > 0 %}{% for severity in ['critical', 'high', 'medium', 'low', 'unknown'] %}{% if (counts[severity] ?? 0) > 0 %} <small>{{ counts[severity] }} {{ severity }}</small>{% endif %}{% endfor %}{% endif %}{% if abandoned > 0 %} · {{ abandoned }} abandoned{% endif %}</span>
{% endif %}

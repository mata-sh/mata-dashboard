{% if targets %}
  <span class="audit-results-label">Result:</span>
{% endif %}
{% for t in targets %}
<span class="audit-chip running" id="audit-chip-{{ t.server }}-{{ t.app }}"
      hx-post="{{ t.url }}" hx-trigger="load" hx-swap="outerHTML">
  <span class="chip-name">{{ t.server }}/{{ t.app }}</span><span class="spinner"></span>
</span>
{% endfor %}

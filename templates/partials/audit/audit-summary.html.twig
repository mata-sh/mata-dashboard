<div class="audit-summary">
  {% if summary.audited_apps == 0 %}
    <span class="audit-empty">No audit data yet &mdash; select apps and run an audit.</span>
  {% else %}
    {% for severity in ['critical', 'high', 'medium', 'low'] %}
      <span class="audit-pill sev-{{ severity }}{% if summary.totals[severity] == 0 %} is-zero{% endif %}"><b>{{ summary.totals[severity] }}</b> {{ severity }}</span>
    {% endfor %}
    {% if summary.totals.unknown > 0 %}
      <span class="audit-pill sev-unknown"><b>{{ summary.totals.unknown }}</b> unknown</span>
    {% endif %}
    {% if summary.abandoned_packages > 0 %}
      <span class="audit-pill pill-abandoned"><b>{{ summary.abandoned_packages }}</b> abandoned</span>
    {% endif %}
    <span class="audit-pill pill-meta"><b>{{ summary.affected_apps }}</b> affected apps</span>
  {% endif %}
</div>

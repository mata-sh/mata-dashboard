{% for server, s in summary.servers %}
  <div class="audit-server-row">
    <div class="audit-server-info" title="toggle all apps on this server"
         _="on click
              set row to closest .audit-server-row
              set boxes to <input[type='checkbox']/> in row
              set checkedBoxes to <input[type='checkbox']:checked/> in row
              repeat for box in boxes
                set box.checked to (checkedBoxes.length is 0)
              end">
      <span class="audit-server-label">{{ server }}</span>
      <span class="audit-server-meta">
        {%- if s.last_audited_label -%}
          audited {{ s.last_audited_label }} ago{% if s.stale %} &middot; stale{% endif %}
        {%- else -%}
          never audited
        {%- endif -%}
      </span>
    </div>
    <div class="audit-server-apps">
      {% for app, info in s.apps %}
        {% set target = server ~ '|' ~ app %}
        <label class="audit-chip {% if info.worst_severity %}sev-{{ info.worst_severity }}{% endif %} {% if info.status == 'error' %}chip-error{% endif %}">
          <input type="checkbox" name="targets[]" value="{{ target }}"{% if selected_targets is null or target in selected_targets %} checked{% endif %}>
          <span class="chip-name">{{ app }}</span>
          {% if (info.counts.total ?? 0) > 0 %}<span class="chip-count">{{ info.counts.total }}</span>{% endif %}
        </label>
      {% else %}
        <span class="audit-server-meta">no applications</span>
      {% endfor %}
    </div>
  </div>
{% endfor %}

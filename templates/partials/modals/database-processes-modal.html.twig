{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'database-processes-modal',
    modal_title: 'Database Processes',
    modal_context: server.name ~ ' / ' ~ connection ~ ' / ' ~ database.name,
    refresh_endpoint: endpoints.refresh,
    wide: true
} %}
  {% block modal_body %}
    {% if own_sessions_only %}
      <p class="notification is-warning">The monitoring account lacks {{ missing_privilege }}; this list only shows its own sessions and is incomplete.</p>
    {% endif %}
    {% if truncated %}
      <p class="notification is-warning">Showing the {{ processes|length }} longest-running sessions; more exist.</p>
    {% endif %}
    {% if summary is not empty %}
      <p class="modal-summary">
        {% for group in summary %}
          {{ group.database }}: {{ group.connections }} connection{{ group.connections == 1 ? '' : 's' }}, {{ group.running }} running{% if not loop.last %} · {% endif %}
        {% endfor %}
      </p>
    {% endif %}
    {% if processes is empty %}
      <div class="modal-empty">No sessions found.</div>
    {% else %}
      <div class="modal-table-shell">
        <table class="modal-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Host</th>
              <th>Database</th>
              <th>Command</th>
              <th>Time</th>
              <th>State</th>
              <th>Statement</th>
            </tr>
          </thead>
          <tbody>
            {% for process in processes %}
              <tr class="modal-row">
                <td class="cell-mono cell-nowrap">{{ process.id ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.user ?? '–' }}</td>
                <td class="cell-mono cell-nowrap">{{ process.host ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.database ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.command ?? '–' }}</td>
                <td class="cell-mono cell-nowrap">{{ process.time_seconds is null ? '–' : process.time_seconds ~ ' s' }}</td>
                <td class="cell-nowrap">{{ process.state ?? '–' }}</td>
                <td class="cell-mono cell-grow">{{ process.statement ?? '–' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  {% endblock %}
{% endembed %}

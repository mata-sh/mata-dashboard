<div id="modal" class="modal is-active database-processes-modal" _="on closeModal add .closing then wait for animationend then remove me">
  <div class="modal-background" _="on click trigger closeModal"></div>
  <div class="modal-content box">
    <div class="modal-top-bar">
      <button class="button modal-close-button-top" _="on click trigger closeModal"><span class="icon is-small">{{ icons.close|raw }}</span></button>
      <div class="title">
        <strong>DATABASE PROCESSES</strong> ( {{ server.name }} / {{ database.name }} )
      </div>
      <div class="title">last fetched: {{ cache.age }} ago</div>
      <button class="button modal-refresh-button-top" hx-get="{{ endpoints.modal_db_processes_refresh }}" hx-target="#modal-container" hx-trigger="click">{{ icons.refresh|raw }} Refresh</button>
    </div>

    <div class="content database-processes-content">
      {% if processes is empty %}
        <div class="notification is-info">No process-list entries found.</div>
      {% else %}
        <div class="table-container">
          <table class="table is-fullwidth is-striped database-processes-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Host</th>
                <th>Database</th>
                <th>Command</th>
                <th>Time</th>
                <th>State</th>
                <th>Info</th>
              </tr>
            </thead>
            <tbody>
              {% for process in processes %}
                <tr>
                  <td>{{ process.id ?? '–' }}</td>
                  <td>{{ process.user ?? '–' }}</td>
                  <td>{{ process.host ?? '–' }}</td>
                  <td>{{ process.db ?? '–' }}</td>
                  <td>{{ process.command ?? '–' }}</td>
                  <td>{{ process.time ?? '–' }}</td>
                  <td>{{ process.state ?? '–' }}</td>
                  <td>{{ process.info ?? '–' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    <br />
    <button class="button is-dark" _="on click trigger closeModal">Close</button>
  </div>
</div>

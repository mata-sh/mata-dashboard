{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'database-processes-modal',
    modal_title: 'Database Processes',
    modal_context: server.name ~ ' / ' ~ database.name,
    refresh_endpoint: endpoints.modal_db_processes_refresh,
    wide: true
} %}
  {% block modal_body %}
    {% if processes is empty %}
      <div class="modal-empty">No process-list entries found.</div>
    {% else %}
      <div class="modal-table-shell">
        <table class="modal-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Host</th>
              <th>Database</th>
              <th>Command</th>
              <th>Time</th>
              <th>State</th>
              <th>Info</th>
            </tr>
          </thead>
          <tbody>
            {% for process in processes %}
              <tr class="modal-row">
                <td class="cell-mono cell-nowrap">{{ process.id ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.user ?? '–' }}</td>
                <td class="cell-mono cell-nowrap">{{ process.host ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.db ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.command ?? '–' }}</td>
                <td class="cell-mono cell-nowrap">{{ process.time ?? '–' }}</td>
                <td class="cell-nowrap">{{ process.state ?? '–' }}</td>
                <td class="cell-mono cell-grow">{{ process.info ?? '–' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  {% endblock %}
{% endembed %}

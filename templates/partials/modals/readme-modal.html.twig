{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'readme-modal',
    modal_title: 'README.md',
    modal_context: app.name ~ ' on ' ~ app.server,
    refresh_endpoint: endpoints.modal_app_readme_refresh
} %}
  {% block modal_body %}
    {% if notice is not null %}
      <div class="notification is-info is-light" role="status" data-notice-code="{{ notice.code }}">
        {{ notice.message }}
      </div>
    {% endif %}
    {{ content.modal_content|raw }}
  {% endblock %}
{% endembed %}

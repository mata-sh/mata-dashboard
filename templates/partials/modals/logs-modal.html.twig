{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'logs-modal',
    modal_title: 'Logs',
    modal_context: app.name ~ ' on ' ~ app.server,
    refresh_endpoint: endpoints.modal_app_logs_refresh,
    wide: true
} %}
  {% block modal_body %}
    {% if logs.readout_limit %}
      <div class="notification is-info is-light">
        Showing the latest {{ logs.readout_limit|number_format }} parsed entries per log file. Older entries are not available in this modal.
      </div>
    {% endif %}
    {{ content.modal_content|raw }}
  {% endblock %}
{% endembed %}

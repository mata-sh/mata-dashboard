{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'server-info-modal',
    modal_title: 'Server Info',
    modal_context: server.name,
    refresh_endpoint: endpoints.modal_server_info_refresh
} %}
  {% block modal_body %}
    <div class="modal-section-grid">
      <div class="modal-section">
        <div class="modal-section-title">Operating System</div>
        <table class="modal-kv">
          <tbody>
            <tr>
              <th>OS Name</th>
              <td>{{ server.os_name }}</td>
            </tr>
            <tr>
              <th>OS Version</th>
              <td>{{ server.os_version }}</td>
            </tr>
            <tr>
              <th>Kernel</th>
              <td class="cell-mono">{{ server.kernel_version }}</td>
            </tr>
            <tr>
              <th>Architecture</th>
              <td class="cell-mono">{{ server.architecture }}</td>
            </tr>
            <tr>
              <th>Hostname</th>
              <td class="cell-mono">{{ server.hostname }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="modal-section">
        <div class="modal-section-title">Software</div>
        <table class="modal-kv">
          <tbody>
            <tr>
              <th>Installed Packages</th>
              <td>{{ server.package_count }}</td>
            </tr>
            <tr>
              <th>PHP Version</th>
              <td>{{ server.php_version }}</td>
            </tr>
            <tr>
              <th>PHP Extensions</th>
              <td>{{ server.php_extension_count }} loaded</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="modal-section is-full">
        <div class="modal-section-title">PHP Extensions ({{ server.php_extension_count }})</div>
        <div class="modal-chips">
          {% for extension in server.php_extensions %}
            <span class="modal-chip">{{ extension }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endblock %}
{% endembed %}

{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'cronjobs-modal',
    modal_title: 'Server Cronjobs',
    modal_context: server.name,
    refresh_endpoint: endpoints.modal_server_cronjobs_refresh
} %}
  {% block modal_body %}
    {% if entries is empty %}
      <div class="modal-empty">No cronjob entries found.</div>
    {% else %}
      <div class="modal-table-shell">
        <table class="modal-table">
          <thead>
            <tr>
              <th>Path</th>
              <th>Status</th>
              <th>Last run</th>
              <th>Age</th>
              <th>Size</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in entries %}
              <tr class="modal-row">
                <td class="cell-mono cell-bright cell-grow">{{ entry.path ?? '–' }}</td>
                <td class="cell-nowrap"><span class="cronjobs-status status-{{ entry.status }}">{{ entry.status }}</span></td>
                <td class="cell-mono cell-nowrap">{{ entry.mtime ?? '–' }}</td>
                <td class="cell-nowrap">{{ entry.age ?? '–' }}</td>
                <td class="cell-nowrap">{{ entry.size ?? '–' }}</td>
              </tr>
              {% if entry.content_tail is not empty %}
                <tr class="cronjobs-tail-row">
                  <td colspan="5">
                    <details class="cronjobs-tail">
                      <summary>Log tail <span class="cronjobs-tail-count">{{ entry.content_tail|length }} line{{ entry.content_tail|length > 1 ? 's' : '' }}</span></summary>
                      <pre>{{ entry.content_tail|join("\n") }}</pre>
                    </details>
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  {% endblock %}
{% endembed %}

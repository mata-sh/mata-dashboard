{% embed "partials/modals/modal-shell.html.twig" with {
    modal_class: 'metrics-modal',
    modal_title: 'Process Count',
    modal_context: server.name,
    modal_meta: 'Range: ' ~ (filters.range|upper) ~ ' · Granularity: ' ~ filters.granularity,
    refresh_endpoint: endpoints.metrics_server
} %}
  {% block modal_body %}
    <div class="metrics-chart-wrapper js-process-count-modal"
      data-element-id="{{ chart.element_id }}"
      data-metric-label="{{ chart.metric_label|e('html_attr') }}"
      data-initial-series="{{ chart.series|json_encode|e('html_attr') }}"
      data-api-endpoint="{{ endpoints.metrics_server_json }}">
      <canvas id="{{ chart.element_id }}"></canvas>
      <div class="metrics-chart-stats">
        <span>{{ icons.activity|raw }} Min: <span data-metric-stat="min">{{ stats.min ?? '—' }}</span></span>
        <span>Max: <span data-metric-stat="max">{{ stats.max ?? '—' }}</span></span>
        <span>Avg: <span data-metric-stat="avg">{{ stats.avg ?? '—' }}</span></span>
        <span>Unit: <span data-metric-stat="unit">{{ stats.unit }}</span></span>
      </div>
      <div class="metrics-chart-empty" {% if chart.series.data|length > 0 %}hidden{% endif %}>
        <p>No process metrics available for the selected range.</p>
      </div>
    </div>
  {% endblock %}
{% endembed %}

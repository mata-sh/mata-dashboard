<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.body.addEventListener('click', function (event) {
      const button = event.target instanceof Element ? event.target.closest('[data-notification-action="close"]') : null
  
      if (!button) {
        return
      }
  
      const notification = button.closest('.notification')
      if (notification) {
        notification.classList.add('is-hidden')
      }
    })
  
    document.body.addEventListener('htmx:afterRequest', function (event) {
      const trigger = event.detail && event.detail.requestConfig ? event.detail.requestConfig.elt : null
  
      if (trigger && trigger.matches && trigger.matches('[data-notification-action="close"]')) {
        const notification = trigger.closest('.notification')
        if (notification) {
          notification.classList.add('is-hidden')
        }
      }
    })
  })
</script>

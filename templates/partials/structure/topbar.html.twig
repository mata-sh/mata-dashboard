<nav class="navbar is-dark is-fixed-top" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a class="navbar-item has-text-weight-bold" href="#" hx-get="{{ endpoints.server_render }}" hx-target="#main-section" hx-swap="innerHTML">{{ layout.organization_name }} <img src="{{ branding.logo_topbar }}" /> <strong>{{ branding.app_name }}</strong></a>
    {% if app_env is defined and app_env != 'prod' %}
      <span class="navbar-item topbar-env-tag app-env {{ app_env }}">{{ app_env }}</span>
    {% endif %}
    <a role="button" class="navbar-burger" data-target="navbar-menu" aria-label="menu" aria-expanded="false">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navbar-menu" class="navbar-menu">
    <div class="navbar-start">
      {% for item in menu %}
        {% if item.enabled %}
          <a class="navbar-item" href="#" hx-get="{{ item.url }}" hx-target="#main-section" hx-swap="innerHTML">{{ item.icon|raw }}{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="navbar-end">
      {% if endpoints.notification_bell_render is defined %}
        <div id="notification-bell"
             class="navbar-item notification-bell"
             hx-get="{{ endpoints.notification_bell_render }}"
             hx-trigger="load, every 60s, bell-refresh from:body"
             hx-swap="innerHTML"></div>
      {% endif %}
      <div class="navbar-item">
        <div class="buttons">
          <form method="post" action="logout">
            <input type="hidden" name="_csrf" value="{{ csrf.token }}" />
            <button class="button is-secondary is-small" type="submit">Logout</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</nav>

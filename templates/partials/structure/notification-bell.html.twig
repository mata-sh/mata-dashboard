{# Inner content of a notification-bell navbar item.
   The wrapper in topbar.html.twig polls this fragment via htmx, so all
   markup here is replaced on every refresh. #}
<span class="notification-bell-trigger {{ total > 0 ? 'has-unacknowledged' : '' }}"
      tabindex="0" aria-label="Notifications" aria-haspopup="true">
  {{ icons.bell|raw }}
  {% if total > 0 %}
    <span class="notification-bell-badge">{{ total }}</span>
  {% endif %}
</span>

<div class="notification-bell-menu" role="menu">
  <div class="notification-bell-head">
    <span>Active alarms</span>
    <a class="notification-bell-viewall"
       href="#"
       hx-get="{{ endpoints.alarms_render }}"
       hx-target="#main-section"
       hx-swap="innerHTML">View all</a>
  </div>

  {% for pill in pills|reverse %}
    {% if pill.count > 0 %}
      <div class="notification-bell-row level-{{ pill.level }}">
        <span class="notification-dot" aria-hidden="true"></span>
        <span class="notification-level">{{ pill.level }}</span>
        <span class="notification-count">{{ pill.count }}</span>
      </div>
    {% endif %}
  {% endfor %}

  {% if total == 0 %}
    <div class="notification-bell-row is-empty">no unacknowledged alarms</div>
  {% else %}
    <div class="notification-bell-foot">
      <a class="notification-ack-all"
         hx-post="{{ endpoints.ack_all }}"
         hx-target="closest .notification-bell"
         hx-swap="innerHTML">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12l5 5l10 -10"></path><path d="M2 12l5 5m5 -5l5 -5"></path></svg>
        Mark all as acknowledged
      </a>
    </div>
  {% endif %}
</div>

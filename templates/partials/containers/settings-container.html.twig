{% set env_name = settings.environment|default('prod') %}
<div class="settings-section">
  <section class="settings-card" id="configuration-overview">
    <h3 class="settings-title" role="button" tabindex="0" aria-controls="configuration-overview-details"
        _="on click or keydown[key=='Enter'] toggle .is-open on #configuration-overview">
      Configuration Files <span class="settings-caret" aria-hidden="true">&#9656;</span>
    </h3>
    <div class="settings-subtitle is-info">
      The dashboard runtime environment is <strong>{{ env_name }}</strong> (APP_ENV: {{ settings.app_environment|default(env_name) }}). Monitoring configuration is shared across all monitored targets. Update files in an editor; changes take effect on the next refresh.
    </div>
    <div class="settings-details" id="configuration-overview-details">
    <div class="settings-paths">
      <div>
        <span class="settings-path-label">Config root</span>
        <code>{{ settings.config_root|default('config') }}</code>
      </div>
    </div>
    <div class="settings-files">
      {% for file in settings.files %}
        <article class="settings-file {{ file.exists ? 'is-present' : 'is-missing' }}">
          <header>
            <h4>{{ file.name }}</h4>
            <span class="settings-status">{{ file.exists ? 'available' : 'missing' }}</span>
          </header>
          <p>{{ file.description }}</p>
          <code>{{ file.path }}</code>
        </article>
      {% endfor %}
    </div>
    </div>
  </section>

  <section class="settings-card" id="monitored-servers">
    <h3 class="settings-title" role="button" tabindex="0" aria-controls="monitored-servers-details"
        _="on click or keydown[key=='Enter'] toggle .is-open on #monitored-servers">
      Monitored Servers <span class="settings-caret" aria-hidden="true">&#9656;</span>
    </h3>
    <p class="settings-subtitle">
      Entries come from <code>servers.json</code>. API keys are masked, but the full value lives in the config file.
    </p>
    <div class="settings-details" id="monitored-servers-details">
    <div class="settings-server-list">
      {% for server in settings.servers %}
        <article class="settings-server"{% if server.colors.primary %} style="--server-accent: {{ server.colors.primary }}"{% endif %}>
          <header>
            <span class="settings-server-name">{{ server.title ? : server.key }}</span>
            <span class="settings-server-key">{{ server.key }}</span>
          </header>
          <dl>
            {% if server.url %}
              <div>
                <dt>Public URL</dt>
                <dd><a href="{{ server.url }}" target="_blank" rel="noreferrer">{{ server.url }}</a></dd>
              </div>
            {% endif %}
            {% if server.api_url %}
              <div>
                <dt>API endpoint</dt>
                <dd>{{ server.api_url }}</dd>
              </div>
            {% endif %}
            {% if server.api_key %}
              <div>
                <dt>API key</dt>
                <dd><code>{{ server.api_key }}</code></dd>
              </div>
            {% endif %}
            {% if server.info %}
              <div>
                <dt>Notes</dt>
                <dd>{{ server.info }}</dd>
              </div>
            {% endif %}
            {% if server.colors.primary or server.colors.secondary %}
              <div>
                <dt>Branding</dt>
                <dd>
                  {% if server.colors.primary %}
                    <span class="settings-color-swatch" style="--swatch-color: {{ server.colors.primary }}">Primary {{ server.colors.primary }}</span>
                  {% endif %}
                  {% if server.colors.secondary %}
                    <span class="settings-color-swatch" style="--swatch-color: {{ server.colors.secondary }}">Secondary {{ server.colors.secondary }}</span>
                  {% endif %}
                </dd>
              </div>
            {% endif %}
          </dl>
          {% if server.extras %}
            <footer>
              <span class="settings-extra-label">Extra flags</span>
              <ul>
                {% for extra in server.extras %}
                  <li>
                    <span>{{ extra.label }}</span><code>{{ extra.value }}</code>
                  </li>
                {% endfor %}
              </ul>
            </footer>
          {% endif %}
        </article>
      {% else %}
        <p class="settings-empty">
          No servers are defined yet. Add entries to <code>servers.json</code> to get started.
        </p>
      {% endfor %}
    </div>
    </div>
  </section>

  <section class="settings-card">
    <div class="settings-subcard" id="cache-windows">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="cache-windows-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #cache-windows">
        Cache Windows <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Values from <code>ttl.json</code>. Negative numbers mean "keep forever".
      </p>
      <div class="settings-details" id="cache-windows-details">
      <ul class="settings-ttl-list">
        {% for ttl in settings.ttl %}
          <li>
            <span class="settings-key">{{ ttl.key }}</span>
            <span class="settings-value">{{ ttl.formatted }} <em>({{ ttl.seconds }}s)</em></span>
          </li>
        {% else %}
          <li class="settings-empty">TTL configuration not available.</li>
        {% endfor %}
      </ul>
      </div>
    </div>
    <div class="settings-subcard" id="alarm-thresholds">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="alarm-thresholds-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #alarm-thresholds">
        Alarm Thresholds <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Summaries from <code>thresholds.json</code>.
      </p>
      <div class="settings-details" id="alarm-thresholds-details">
      <div class="settings-thresholds">
        {% for section in settings.thresholds %}
          <section>
            <h4>{{ section.section }}</h4>
            <ul>
              {% for metric in section.metrics %}
                <li>
                  <span class="settings-key">{{ metric.metric }}</span>
                  <span class="settings-threshold-values">
                    {% for level in metric.levels %}
                      <span class="settings-threshold-chip{% if level.label in ['good', 'warn', 'critical', 'alarm'] %} is-{{ level.label }}{% endif %}">
                        <span>{{ level.label }}</span>
                        <strong>{{ level.value }}</strong>
                      </span>
                    {% endfor %}
                  </span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% else %}
          <p class="settings-empty">Threshold configuration not available.</p>
        {% endfor %}
      </div>
      </div>
    </div>
    <div class="settings-subcard" id="cooldown-intervals">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="cooldown-intervals-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #cooldown-intervals">
        Cooldown Intervals <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Values from <code>intervals.json</code>, in minutes. <code>_default</code> applies to any key not listed; <em>no cooldown</em> means every occurrence is recorded.
      </p>
      <div class="settings-details" id="cooldown-intervals-details">
      <div class="settings-groups">
        {% for section in settings.intervals %}
          <section>
            <h4>{{ section.section }}</h4>
            {% for group in section.groups %}
              <p class="settings-group-label"><code>{{ group.group }}</code></p>
              <ul class="settings-ttl-list is-stacked">
                {% for entry in group.entries %}
                  <li>
                    <span class="settings-key">{{ entry.key }}</span>
                    <span class="settings-value">
                      {{ entry.formatted }}{% if entry.minutes %} <em>({{ entry.minutes }}m)</em>{% endif %}
                    </span>
                  </li>
                {% endfor %}
              </ul>
            {% endfor %}
          </section>
        {% else %}
          <p class="settings-empty">Interval configuration not available.</p>
        {% endfor %}
      </div>
      </div>
    </div>
    <div class="settings-subcard" id="probe-behaviour">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="probe-behaviour-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #probe-behaviour">
        Probe Behaviour <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Values from <code>probes.json</code>. Controls how reachability checks time out and retry.
      </p>
      <div class="settings-details" id="probe-behaviour-details">
      <ul class="settings-ttl-list">
        {% for probe in settings.probes %}
          <li>
            <span class="settings-key">{{ probe.key }}</span>
            <span class="settings-value">{{ probe.formatted }}</span>
          </li>
        {% else %}
          <li class="settings-empty">Probe configuration not available.</li>
        {% endfor %}
      </ul>
      </div>
    </div>
    <div class="settings-subcard" id="alarm-rate-limits">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="alarm-rate-limits-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #alarm-rate-limits">
        Alarm Rate Limits <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Values from <code>limits.json</code>. Delivery ceilings resolve as server override &rarr; channel &rarr; default.
      </p>
      <div class="settings-details" id="alarm-rate-limits-details">
      <div class="settings-thresholds">
        {% if settings.limits.default %}
          <section>
            <h4>default</h4>
            <ul>
              <li>
                <span class="settings-key">all channels</span>
                <span class="settings-threshold-values">
                  <span class="settings-threshold-chip"><span>per minute</span><strong>{{ settings.limits.default.per_minute }}</strong></span>
                  <span class="settings-threshold-chip"><span>per hour</span><strong>{{ settings.limits.default.per_hour }}</strong></span>
                  <span class="settings-threshold-chip"><span>per day</span><strong>{{ settings.limits.default.per_day }}</strong></span>
                </span>
              </li>
            </ul>
          </section>
        {% endif %}
        {% if settings.limits.channels %}
          <section>
            <h4>channels</h4>
            <ul>
              {% for channel in settings.limits.channels %}
                <li>
                  <span class="settings-key">{{ channel.channel }}</span>
                  <span class="settings-threshold-values">
                    <span class="settings-threshold-chip"><span>per minute</span><strong>{{ channel.limits.per_minute }}</strong></span>
                    <span class="settings-threshold-chip"><span>per hour</span><strong>{{ channel.limits.per_hour }}</strong></span>
                    <span class="settings-threshold-chip"><span>per day</span><strong>{{ channel.limits.per_day }}</strong></span>
                  </span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
        {% for override in settings.limits.overrides %}
          <section>
            <h4>override: {{ override.server }}</h4>
            <ul>
              {% for channel in override.channels %}
                <li>
                  <span class="settings-key">{{ channel.channel }}</span>
                  <span class="settings-threshold-values">
                    <span class="settings-threshold-chip"><span>per minute</span><strong>{{ channel.limits.per_minute }}</strong></span>
                    <span class="settings-threshold-chip"><span>per hour</span><strong>{{ channel.limits.per_hour }}</strong></span>
                    <span class="settings-threshold-chip"><span>per day</span><strong>{{ channel.limits.per_day }}</strong></span>
                  </span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endfor %}
        {% if not settings.limits.default and not settings.limits.channels %}
          <p class="settings-empty">Alarm limit configuration not available.</p>
        {% endif %}
      </div>
      </div>
    </div>
    <div class="settings-subcard" id="mail-transport">
      <h3 class="settings-title" role="button" tabindex="0" aria-controls="mail-transport-details"
          _="on click or keydown[key=='Enter'] toggle .is-open on #mail-transport">
        Mail Transport <span class="settings-caret" aria-hidden="true">&#9656;</span>
      </h3>
      <p class="settings-subtitle">
        Values from <code>mail.config.env</code>. The transport password is never displayed.
      </p>
      <div class="settings-details" id="mail-transport-details">
      {% if settings.mail.configured %}
        <ul class="settings-ttl-list is-stacked">
          {% if settings.mail.transport.configured %}
            <li>
              <span class="settings-key">transport</span>
              <span class="settings-value">{{ settings.mail.transport.scheme ? : 'unknown' }}</span>
            </li>
            <li>
              <span class="settings-key">server</span>
              <span class="settings-value">
                {{ settings.mail.transport.host ? : 'not set' }}{% if settings.mail.transport.port %} <em>(port {{ settings.mail.transport.port }})</em>{% endif %}
              </span>
            </li>
            <li>
              <span class="settings-key">username</span>
              <span class="settings-value">{{ settings.mail.transport.username ? : 'not set' }}</span>
            </li>
            <li>
              <span class="settings-key">password</span>
              <span class="settings-value">{{ settings.mail.transport.has_password ? 'set (hidden)' : 'not set' }}</span>
            </li>
          {% else %}
            <li>
              <span class="settings-key">transport</span>
              <span class="settings-value">not configured</span>
            </li>
          {% endif %}
          <li>
            <span class="settings-key">from</span>
            <span class="settings-value">
              {{ settings.mail.from_email ? : 'not set' }}{% if settings.mail.from_name %} <em>({{ settings.mail.from_name }})</em>{% endif %}
            </span>
          </li>
          <li>
            <span class="settings-key">mailer (app / dev)</span>
            <span class="settings-value">{{ settings.mail.mailer_app }} / {{ settings.mail.mailer_dev }}</span>
          </li>
          <li>
            <span class="settings-key">charset</span>
            <span class="settings-value">{{ settings.mail.charset }} <em>(wrap {{ settings.mail.word_wrap }})</em></span>
          </li>
          {% if settings.mail.dashboard_url %}
            <li>
              <span class="settings-key">dashboard URL</span>
              <span class="settings-value">{{ settings.mail.dashboard_url }}</span>
            </li>
          {% endif %}
          {% for recipient in settings.mail.recipients %}
            <li>
              <span class="settings-key">{{ recipient.label }} recipients</span>
              <span class="settings-value">{{ recipient.addresses ? recipient.addresses|join(', ') : 'none' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="settings-empty">Mail configuration not available.</p>
      {% endif %}
      </div>
    </div>
  </section>
</div>

<div class="events-section">
    <h3>Alarms<span class="section-help-icon" data-tippy-content="Alarms: events that crossed alarm policy thresholds. They appear in the notification bell and may trigger email notifications. Acknowledge them once handled.">{{ icons.help|raw }}</span></h3>

    <div class="filter-menu">
        <input id="filter-time" type="text" placeholder="2025.05.08 20:00:00">
        <input id="filter-from" type="datetime-local" placeholder="">
        <input id="filter-to" type="datetime-local" placeholder="">
        <select id="filter-level">
            <option value="">Level</option>
            <option value="critical">Critical</option>
            <option value="error">Error</option>
            <option value="warning">Warning</option>
            <option value="info">Info</option>
        </select>
        <label class="toggle filter-unacknowledged">
            <input type="checkbox" id="filter-unacknowledged">
            <span class="toggle-track"></span>
            <span class="toggle-text">unacknowledged only</span>
        </label>
        <select id="filter-app">
            <option value="">All Apps</option>
        </select>
        <select id="filter-server">
            <option value="">All Servers</option>
        </select>

        <input id="filter-id" type="text" placeholder="ID">
        <input id="filter-type" type="text" placeholder="Type">
        <input id="filter-msg" type="text" placeholder="Message">

        <button class="button" id="filter-clear">Clear Filter</button>
        <button type="button" class="button" id="alarms-ack-all"
                data-ack-all-url="{{ endpoints.ack_all }}"
                title="Acknowledge all alarms, regardless of active filters">Acknowledge all</button>
    </div>

    <div id="alarms-table"
         data-alarms-url="{{ endpoints.alarms_json }}"
         data-acknowledge-url="{{ endpoints.alarms_ack }}"></div>
</div>

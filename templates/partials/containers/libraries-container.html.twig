<div class="libraries-section">
  <div id="audit-section" hx-get="{{ endpoints.audit_section }}" hx-trigger="load" hx-swap="outerHTML"></div>
  <h3>Libraries</h3>

  <div class="filter-menu">
    <input id="filter-name" type="text" placeholder="Name" />
    <input id="filter-version" type="text" placeholder="Version" />
    <select id="filter-app">
      <option value="">All Apps</option>
    </select>
    <select id="filter-server">
      <option value="">All Servers</option>
      {% for server in filters.servers %}
        <option value="{{ server.value }}">{{ server.label }}</option>
      {% endfor %}
    </select>
    <input id="filter-description" type="text" placeholder="Description" />
    <label class="toggle filter-vulnerable">
      <input type="checkbox" id="filter-vulnerable">
      <span class="toggle-track"></span>
      <span class="toggle-text">vulnerable only</span>
    </label>
    <button class="button" id="filter-clear">Clear Filter</button>
    <button type="button" class="button" hx-get="{{ endpoints.libraries_render }}" hx-target="#main-section" hx-swap="innerHTML">Refresh</button>
  </div>

  <div id="libraries-errors" class="server-fetch-error" hidden></div>
  <div id="libraries-table" data-libraries-url="{{ endpoints.libraries_json }}"></div>
</div>

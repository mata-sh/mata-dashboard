{#- Discord webhook. Autoescape is off for JSON templates: every value must pass through json_encode.
    Discord rejects content over 2000 characters; allowed_mentions stops a message from pinging @everyone or roles. -#}
{%- set text -%}
{{ severity.emoji }} {{ severity.value|upper }} · {{ target.is_server_only ? target.server : target.heading }}
{{ alarm.title }}

{{ alarm.message|slice(0, 1500) }}

{{ target.environment ? target.environment.value ~ ' · ' }}alarm #{{ alarm.id }} · {{ alarm.created_at }}{{ dashboard_url ? "\n<" ~ dashboard_url ~ ">" }}
{%- endset -%}
{
  "content": {{ text|slice(0, 2000)|json_encode }},
  "allowed_mentions": {"parse": []}
}

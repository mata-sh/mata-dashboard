{% set error_type = error.type|default('error') %}
{% set heading = error.heading|default(error.title|default('Error')) %}
{% set title = error.title|default(heading) %}
{% set icon_map = {'warning': '!', 'error': 'x', 'info': 'i'} %}
{% set icon = icon_map[error_type]|default('x') %}
{% set asset_base_url = asset_base_url|default('/assets') %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>{{ title }}</title>
  <style>
    @font-face {
      font-family: "Nunito";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("{{ asset_base_url }}/fonts/nunito/nunito-400-latin.woff2") format("woff2");
    }

    @font-face {
      font-family: "Nunito";
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url("{{ asset_base_url }}/fonts/nunito/nunito-700-latin.woff2") format("woff2");
    }

    :root {
      --surface-base: #0b0d12;
      --surface-panel: #0e1015;
      --surface-raised: #12151c;
      --surface-control: #10131a;
      --border-default: #1f242e;
      --border-control: #262c38;
      --text-bright: #e8eaf0;
      --text-body: #c9cfda;
      --text-muted: #8b93a5;
      --accent-border: #3f93a6;
      --accent-fill: #10262b;
      --accent-text: #9fe8f2;
      --sev-critical-border: #e05561;
      --sev-critical-tint: #f09595;
      --sev-medium-border: #c4a53a;
      --sev-medium-tint: #e3ce7a;
    }

    * { box-sizing: border-box; }

    body { margin: 0; background: var(--surface-base); color: var(--text-body); }

    .error-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      background:
        radial-gradient(circle at 50% -20%, rgba(63, 147, 166, .16), transparent 48%),
        var(--surface-base);
      font-family: "Nunito", Arial, sans-serif;
    }

    .error-card {
      width: 100%;
      max-width: 680px;
      background: var(--surface-panel);
      border: 1px solid var(--border-default);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(0, 0, 0, .45);
    }

    .error-card[data-type="warning"] {
      --error-bg: rgba(156, 124, 20, .12);
      --error-border: var(--sev-medium-border);
      --error-text: var(--sev-medium-tint);
    }

    .error-card[data-type="error"] {
      --error-bg: rgba(194, 42, 53, .12);
      --error-border: var(--sev-critical-border);
      --error-text: var(--sev-critical-tint);
    }

    .error-card[data-type="info"] {
      --error-bg: var(--accent-fill);
      --error-border: var(--accent-border);
      --error-text: var(--accent-text);
    }

    .error-header {
      background: var(--surface-raised);
      border-bottom: 1px solid var(--border-default);
      border-left: 3px solid var(--error-border);
      padding: 24px 28px;
      color: var(--error-text);
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .error-icon {
      width: 34px;
      height: 34px;
      border-radius: 999px;
      background: var(--error-bg);
      border: 1px solid var(--error-border);
      color: var(--error-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-family: "Courier New", monospace;
      text-transform: uppercase;
    }

    .error-kicker {
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .error-title {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-bright);
      margin: 2px 0 0;
    }

    .error-body {
      padding: 28px;
      color: var(--text-body);
    }

    .error-message {
      margin-bottom: 16px;
      line-height: 1.6;
    }

    .error-section { margin-top: 16px; }

    .error-subtitle {
      display: block;
      margin-bottom: 8px;
      color: var(--text-body);
      font-weight: 600;
    }

    .error-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .error-list li {
      padding: 8px 12px;
      margin: 6px 0;
      background: var(--surface-control);
      border-left: 2px solid var(--error-border);
      border-radius: 4px;
      font-family: "Courier New", monospace;
      font-size: 14px;
    }

    .error-technical { color: var(--text-muted); font-size: 14px; }

    .error-technical code,
    .error-command code {
      background: var(--surface-control);
      padding: 2px 6px;
      border: 1px solid var(--border-control);
      border-radius: 3px;
      font-family: "Courier New", monospace;
      font-size: 13px;
      color: var(--accent-text);
    }

    .error-hint {
      margin: 0 0 8px;
      line-height: 1.6;
    }

    .error-command {
      margin: 6px 0;
      overflow-wrap: anywhere;
    }

    .error-footer {
      background: var(--surface-raised);
      padding: 18px 28px;
      border-top: 1px solid var(--border-default);
      font-size: 14px;
      color: var(--text-muted);
    }

    .error-doc-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      padding: 10px 16px;
      background: var(--accent-fill);
      border: 1px solid var(--accent-border);
      color: var(--accent-text);
      text-decoration: none;
      border-radius: 5px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .error-doc-link:hover { background: #153238; }
    .error-doc-icon { font-size: 18px; }
  </style>
</head>
<body>
  <section class="error-page">
    <div class="error-card" data-type="{{ error_type }}">
      <div class="error-header">
        <span class="error-icon">{{ icon }}</span>
        <div>
          <div class="error-kicker">{{ title }}</div>
          <h1 class="error-title">{{ heading }}</h1>
        </div>
      </div>
      <div class="error-body">
        <div class="error-message">{{ error.message }}</div>
        {% block error_details %}{% endblock %}
      </div>
      <div class="error-footer">
        Check application logs for technical details.
        {% if error.documentation_url is defined and error.documentation_url %}
          <br>
          <a href="{{ error.documentation_url }}" class="error-doc-link" target="_blank" rel="noopener noreferrer">
            <span>View Documentation</span>
          </a>
        {% endif %}
      </div>
    </div>
  </section>
</body>
</html>

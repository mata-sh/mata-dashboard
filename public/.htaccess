Order allow,deny
Allow from all

AuthType Basic
# AuthName "Restricted Area"
# AuthUserFile /var/www/vhosts/ids-cloud.eu/httpdocs/mata-dashboard/config/.htpasswd
# Require valid-user


RewriteEngine On
RewriteBase /

# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect all to index.php
RewriteRule ^ index.php [QSA,L]




# Disable directory listing
Options -Indexes

# Block all files except
<FilesMatch "\.((?!(php|pdf|csv|html|css|js|png|jpg|jpeg|gif|svg|ico|xml|woff|woff2|ttf)$).)*$">
    Require all denied
</FilesMatch>

# Block access (composer, .htaccess, .gitignore)
<FilesMatch "^(composer\.(json|lock)|\.htaccess|\.htpasswd|\.env|\.gitignore|package\.json)$">
    Require all denied
</FilesMatch>


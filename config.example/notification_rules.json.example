{
  "defaults": {
    "enabled": true,
    "channels": ["email"]
  },
  "event_types": {
    "fatal_errors_occurring": {
      "enabled": true,
      "channels": ["email"]
    }
  },
  "application_overrides": {
    "noisy-app": {
      "fatal_errors_occurring": {
        "enabled": false,
        "channels": []
      }
    }
  }
}

{
  "_README": {
    "description": "Node API keys for the servers in servers.json, keyed by the same server name. Each api_key must equal that node's DASHBOARD_API_KEY.",
    "security_note": "Never commit servers.secrets.json; anyone holding a key can query that node's API.",
    "api_key_generation": "openssl rand -hex 32"
  },
  "_EXAMPLE": {
    "api_key": "replace-with-DASHBOARD_API_KEY"
  },
  "_EXAMPLE_LOCAL_DEV": {
    "api_key": "replace-with-DASHBOARD_API_KEY"
  }
}

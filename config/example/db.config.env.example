# ========================================
# MATA Dashboard - Database Configuration
# ========================================
# ========================================
# MySQL/MariaDB Connection
# ========================================

# Database server hostname or IP address
DB_HOST=localhost

# Database server port (default MySQL port is 3306)
DB_PORT=3306

# Database name for MATA Dashboard
DB_DATABASE=mata_dashboard

# Database username
DB_USERNAME=mata_user

# Database password
DB_PASSWORD=change_me

# Mysql Root password
MYSQL_ROOT_PASSWORD=change_me_in_production

# ========================================
# Connection Settings
# ========================================

# Character set for database connection
DB_CHARSET=utf8mb4

# Collation for database connection
DB_COLLATION=utf8mb4_unicode_ci

# ========================================
# Connection Pool Settings
# ========================================

# Connection timeout in seconds
DB_TIMEOUT=30

# Enable persistent connections (true/false)
DB_PERSISTENT=false

# Maximum number of connections
DB_MAX_CONNECTIONS=100

# ========================================
# SSL/TLS Configuration (Optional)
# ========================================

# Enable SSL connection (true/false)
# DB_SSL_ENABLED=false

# SSL certificate authority file path
# DB_SSL_CA=/path/to/ca-cert.pem

# SSL certificate file path
# DB_SSL_CERT=/path/to/client-cert.pem

# SSL private key file path
# DB_SSL_KEY=/path/to/client-key.pem

# Verify SSL certificate (true/false)
# DB_SSL_VERIFY=true

# ========================================
# Performance Settings
# ========================================

# Query cache settings (if supported by your MySQL version)
DB_QUERY_CACHE=true

# Connection compression (true/false)
DB_COMPRESSION=false

# ========================================
# Monitoring & Logging
# ========================================

# Enable slow query logging (true/false)
DB_SLOW_QUERY_LOG=true

# Slow query threshold in seconds
DB_SLOW_QUERY_THRESHOLD=2

# Enable query logging for debugging (true/false) - disable in production
DB_QUERY_LOG=false

# ========================================
# Backup Settings
# ========================================

# Database backup configuration (if using automated backups)
# DB_BACKUP_ENABLED=true
# DB_BACKUP_SCHEDULE=daily
# DB_BACKUP_RETENTION_DAYS=30
# DB_BACKUP_PATH=/path/to/backups

# ========================================
# Development Settings
# ========================================

# Enable database debugging (true/false) - disable in production
DB_DEBUG=false

# Show database queries in application logs (true/false)
DB_SHOW_QUERIES=false

# Enable database profiling (true/false) - development only
DB_PROFILING=false

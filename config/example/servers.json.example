        "primary_color": "#ffc107",
        "secondary_color": "#212529",
        "info": "Staging Environment - Testing & QA",
        "check_disk_space": "on"
    },
    
    "development-server": {
        "url": "https://dev.your-domain.com/",
        "api_url": "https://dev.your-domain.com/mata-node/api",
        "api_key": "dev_environment_api_key_32_chars",
        "primary_color": "#17a2b8",
        "secondary_color": "#ffffff", 
        "info": "Development Server - Testing New Features",
        "check_disk_space": "off"
    },
    
    "database-server": {
        "url": "https://db.your-domain.com/",
        "api_url": "https://db.your-domain.com/mata-node/api",
        "api_key": "database_server_api_key_32_chars",
        "primary_color": "#6f42c1",
        "secondary_color": "#ffffff",
        "info": "Dedicated Database Server - MySQL/MariaDB",

{
  "_README": {
    "description": "Rename _EXAMPLE to the node's DASHBOARD_SERVER_ID and replace every placeholder.",
    "security_note": "Never commit config/servers.json; it contains node secrets.",
    "api_key_generation": "openssl rand -hex 32"
  },
  "_EXAMPLE": {
    "title": "Production web",
    "url": "https://app.example.com/",
    "api_url": "https://node.example.com/",
    "api_key": "replace-with-DASHBOARD_API_KEY",
    "error_monitoring_enabled": true,
    "logsize_monitoring_enabled": true
  },
  "_EXAMPLE_LOCAL_DEV": {
    "title": "Local development",
    "disabled": false,
    "env": "dev",
    "url": "http://localhost:3300/",
    "api_url": "http://localhost:3310/",
    "api_key": "replace-with-DASHBOARD_API_KEY",
    "allow_http": "on",
    "suppress_http_warning": "on",
    "primary_color": "#17a2b8",
    "secondary_color": "#ffffff",
    "info": "Local only — allow_http must never be set in production"
  }
}

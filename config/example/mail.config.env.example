# ========================================
# MATA Dashboard - Email Configuration
# ========================================
# Copy to config/mail.config.env and replace the placeholders.
# Comma-separated recipient lists

# ========================================
# Email Recipients
# ========================================
# Test email recipients (for testing email functionality)
MAIL_TEST_RECIPIENTS="admin@your-domain.com"

# Alarm recipients (for monitoring alarms and notifications)
MAIL_ALARM_RECIPIENTS="alarms@your-domain.com"

# Development team recipients (for development notifications)
MAIL_DEV_RECIPIENTS="dev-team@your-domain.com"

# ========================================
# Symfony Mailer Configuration
# ========================================
# Symfony Mailer DSN format examples:
# SMTP: smtp://username:password@smtp.example.com:587
# Gmail: gmail://username:password@default
# SendGrid: sendgrid://api_key@default
# Postmark: postmark://token@default

SYM_MAILER_DSN="smtp://your_smtp_user:your_smtp_password@smtp.your-provider.com:587"
SYM_FROM_EMAIL="noreply@your-domain.com"
SYM_FROM_NAME="MATA Dashboard"

# ========================================
# Email Settings
# ========================================
# Global email configuration

# Character encoding for emails
MAIL_CHARSET=utf-8

# Optional absolute URL shown in alarm emails
# MAIL_DASHBOARD_URL="https://mata.example.com/"
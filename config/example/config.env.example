# ========================================
# MATA Dashboard Configuration
# ========================================
# Copy this file to config.env and update with your actual values
# DO NOT commit config.env to version control

# Defaults to prod so manually copied configuration is safe by default.
# Set this to the selected environment; in Docker it must match .env.
APP_ENV=prod

# ========================================
# Application Settings
# ========================================
# Domain configuration
DOMAIN="your-domain.com"
DIR=

# Application branding
# Name shown in the browser title, topbar and login page
# Logos are customized separately: see public/branding/README.md
APP_NAME=MATA

# Optional organization name shown before the logo in the topbar
ORGANIZATION_TITLE=

# ========================================
# Application Settings
# ========================================
# Enable/disable maintenance mode (ON/OFF)
MAINTENANCE_MODE_ENABLED=OFF

# IP whitelisting for login protection (ON/OFF)
# When enabled, only IPs in ALLOWED_IPS can access the login page
# Useful for enterprise environments with static IPs
IP_WHITELIST_ENABLED=OFF
ALLOWED_IPS=127.0.0.1,::1

# Send browser security headers such as CSP and HSTS (ON/OFF)
# Set OFF only while debugging browser integrations.
SECURITY_HEADERS_ENABLED=ON

# Dashboard layout (number of server columns in main grid)
DASHBOARD_SERVER_COLUMNS=2

# Dashboard container width in pixels (Bulma default is 1344)
DASHBOARD_CONTAINER_WIDTH=1344

# ========================================
# PHP Runtime Settings
# ========================================
# Display PHP errors (1/0) - should be 0 in production
DISPLAY_ERRORS=1

# PHP error log level: notices, warnings, errors
LOG_LEVEL=notices

# ========================================
# Application Logging
# ========================================
# Monolog level: debug, info, notice, warning, error, critical, alarm, emergency
MONOLOG_LEVEL=debug

# ========================================
# Filesystem Paths
# ========================================
# Application log file path (relative to app root or absolute)
APP_LOG_PATH=logs/app.log

# Temp directory for runtime/cache files (relative to app root or absolute)
# Leave empty to use default: <app>/temp
TEMP_DIR=

# ========================================
# OPA Alarm Decision
# ========================================
# OPA base URL (include scheme and port)
OPA_ALARM_BASE_URI=http://mata-opa:3320
# OPA decision endpoint path
OPA_ALARM_DECISION_PATH=/v1/data/alarms/decision
# OPA request timeout in seconds
OPA_ALARM_TIMEOUT_SECONDS=5
# Maximum events evaluated per cron run
OPA_ALARM_BATCH_LIMIT=100

# ========================================
# Template System
# ========================================
# Template engine debug mode (ON/OFF)
TEMPLATE_DEBUG_ENABLED=OFF

# ========================================
# CLI Security Settings
# ========================================
# Enforce strict user checking for manage-users.php (ON/OFF)
# ON: Only root and http users can run the script (recommended for VPS/dedicated servers)
# OFF: Any user can run the script (suitable for shared hosting environments)
CLI_STRICT_USER_CHECK=OFF

# Allowed users for CLI scripts (comma-separated, only used if strict checking is ON)
CLI_ALLOWED_USERS=root,http,www-data

# ========================================
# Rate Limiting
# ========================================
# Enable/disable rate limiting globally (ON/OFF)
RATE_LIMIT_ENABLED=ON

# Rate limiting storage backend: file, redis
# file: Store rate limit data in filesystem (default, no dependencies)
# redis: Store rate limit data in Redis (requires Redis server)
RATE_LIMIT_STORAGE=file

# File storage path for rate limiting (only used if RATE_LIMIT_STORAGE=file)
# Leave empty to use default: sys_get_temp_dir()/cache/rate_limit
RATE_LIMIT_FILE_PATH=

# Redis connection settings (only used if RATE_LIMIT_STORAGE=redis)
RATE_LIMIT_REDIS_HOST=127.0.0.1
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_REDIS_PASSWORD=
RATE_LIMIT_REDIS_DATABASE=0

# Rate limits per route group
# Login routes (/login, /logout) - Stricter limits to prevent brute force attacks
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Dashboard and watch routes (/watch/*) - Moderate limits for authenticated users
RATE_LIMIT_DASHBOARD_MAX_REQUESTS=100
RATE_LIMIT_DASHBOARD_WINDOW_SECONDS=60

# API metrics routes (/api/metrics/*) - Higher limits for data-heavy endpoints
RATE_LIMIT_API_MAX_REQUESTS=200
RATE_LIMIT_API_WINDOW_SECONDS=60

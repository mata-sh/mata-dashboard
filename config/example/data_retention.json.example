{
    "_comment": "Data retention configuration for alarms, events, and server/application metrics. Set a retention value to 0 to disable cleanup for that category.",
    "metrics": {
        "_comment_raw_retention_days": "Days to retain raw metric samples",
        "raw_retention_days": 30,
        "_comment_hourly_retention_days": "Days to retain hourly metric aggregates",
        "hourly_retention_days": 90,
        "_comment_daily_retention_days": "Days to retain daily metric aggregates",
        "daily_retention_days": 365
    },
    "events": {
        "_comment_retention_days": "Days to retain events without an alarm",
        "retention_days": 180
    },
    "alarms": {
        "_comment_retention_days": "Days to retain alarms without pending, processing, or retry deliveries",
        "retention_days": 365
    },
    "aggregation": {
        "hourly": {
            "_comment_lag_minutes": "Minutes to wait before considering the previous hour complete",
            "lag_minutes": 5,
            "_comment_catch_up_hours": "Maximum number of past hours to catch up in a single run",
            "catch_up_hours": 24
        },
        "daily": {
            "_comment_lag_minutes": "Minutes to wait after midnight before rolling the previous day",
            "lag_minutes": 30,
            "_comment_catch_up_days": "Completed UTC days reprocessed per run to repair missed or late data",
            "catch_up_days": 7
        }
    },
    "pruning": {
        "_comment_batch_limit": "Rows per delete statement/batch; cleanup repeats bounded batches until the table is drained",
        "batch_limit": 5000
    },
    "ingestion_health": {
        "_comment_stall_minutes": "Trigger stall alerts if no new rows arrive within this many minutes",
        "stall_minutes": 15,
        "_comment_log_rotate_megabytes": "Rotate health log when it exceeds this size (MB)",
        "log_rotate_megabytes": 5,
        "_comment_log_rotate_files": "Number of rotated health log files to retain",
        "log_rotate_files": 3
    }
}

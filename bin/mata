#!/usr/bin/env php
<?php

declare(strict_types=1);

use Mata\Cli\CliApplication;
use Mata\Cli\CliConfig;
use Mata\Cli\Command\AlarmExplainCommand;
use Mata\Cli\Command\AlarmTestCommand;
use Mata\Cli\Command\ConfigValidateCommand;
use Mata\Cli\Command\DbCheckCommand;
use Mata\Cli\Command\DbMigrateCommand;
use Mata\Cli\Command\DbRollbackCommand;
use Mata\Cli\Command\DbStatusCommand;
use Mata\Cli\Command\DoctorCommand;
use Mata\Cli\Command\ServerAddCommand;
use Mata\Cli\Command\ServerListCommand;
use Mata\Cli\Command\ServerRemoveCommand;
use Mata\Cli\Command\ServerTestCommand;
use Mata\Cli\Command\StatusCommand;
use Mata\Cli\Command\UserCreateCommand;
use Mata\Cli\Command\UserDeleteCommand;
use Mata\Cli\Command\UserListCommand;
use Mata\Cli\Command\UserPasswdCommand;
use Mata\Cli\Command\UserUnlockCommand;
use Mata\Config\Dto\NodeApiConfig;
use Mata\Config\Monitoring\ServersConfigEditor;
use Mata\Config\Validation\InstanceConfigValidator;
use Mata\Services\Monitor\HttpProbeClient;
use Mata\Services\Monitor\NodeConnectionTester;
use Mata\Utils\PathResolver;
use Symfony\Component\Console\Input\ArgvInput;

require_once __DIR__ . '/../vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// Root would read files the web server cannot and create cache files the web app cannot overwrite.
if (function_exists('posix_geteuid') && posix_geteuid() === 0 && getenv('MATA_ALLOW_ROOT') !== '1') {
    fwrite(STDERR, "Refusing to run as root. Run as the web server user (server add/remove: as the owner of config/), e.g.\n"
        . "  docker exec -u www-data mata-dashboard-web php bin/mata …\n"
        . "  sudo -u www-data php bin/mata …   (http on Arch, apache on RHEL)\n"
        . "Set MATA_ALLOW_ROOT=1 to override.\n");

    exit(2);
}

// Like the app, every command uses config/; point it elsewhere with a symlink. Only
// `config validate --path` reads another directory, e.g. a config repo pre-commit hook.
$paths = PathResolver::fromAppPath(dirname(__DIR__));
$configPath = $paths->configPath;
$cli = new CliConfig($paths);

$serverFiles = new ServersConfigEditor($configPath);
$connectionTester = new NodeConnectionTester(new HttpProbeClient(), NodeApiConfig::DEFAULT_TIMEOUT_SECONDS);

$application = new CliApplication('mata', 'dashboard');
$application->addCommands([
    new ConfigValidateCommand(new InstanceConfigValidator(), $configPath),
    new ServerListCommand($serverFiles),
    new ServerAddCommand($serverFiles, $connectionTester),
    new ServerTestCommand($serverFiles, $connectionTester),
    new ServerRemoveCommand($serverFiles),
    new StatusCommand($cli),
    new UserListCommand($cli),
    new UserCreateCommand($cli),
    new UserPasswdCommand($cli),
    new UserUnlockCommand($cli),
    new UserDeleteCommand($cli),
    new DbStatusCommand($cli),
    new DbMigrateCommand($cli),
    new DbRollbackCommand($cli),
    new DbCheckCommand($cli),
    new DoctorCommand($cli),
    new AlarmTestCommand(__FILE__),
    new AlarmExplainCommand($cli),
]);

// Accept `mata config validate` as well as Symfony's `mata config:validate`.
$argv = $_SERVER['argv'] ?? [];
if (is_array($argv) && isset($argv[1], $argv[2]) && is_string($argv[1]) && is_string($argv[2]) && $application->has("{$argv[1]}:{$argv[2]}")) {
    array_splice($argv, 1, 2, ["{$argv[1]}:{$argv[2]}"]);
}

$input = new ArgvInput(array_values(array_filter($argv, 'is_string')));
// Never prompt when an agent or script drives the CLI; commands then need --yes.
if (!stream_isatty(STDIN)) {
    $input->setInteractive(false);
}

exit($application->run($input));

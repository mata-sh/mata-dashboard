#!/usr/bin/env php
<?php

declare(strict_types=1);

use Mata\Cli\CliApplication;
use Mata\Cli\CliConfig;
use Mata\Cli\Command\Advisory\AdvisoryFetchCommand;
use Mata\Cli\Command\Advisory\AdvisoryReportCommand;
use Mata\Cli\Command\Advisory\AdvisorySourcesCommand;
use Mata\Cli\Command\Alarm\AlarmExplainCommand;
use Mata\Cli\Command\Alarm\AlarmsListCommand;
use Mata\Cli\Command\Alarm\AlarmTestCommand;
use Mata\Cli\Command\Apps\AppsListCommand;
use Mata\Cli\Command\Apps\AppsReadmeCommand;
use Mata\Cli\Command\Apps\AppsSessionsCommand;
use Mata\Cli\Command\Audit\AuditShowCommand;
use Mata\Cli\Command\Config\ConfigValidateCommand;
use Mata\Cli\Command\Cronjobs\CronjobsShowCommand;
use Mata\Cli\Command\Db\DbProcessesCommand;
use Mata\Cli\Command\Db\DbShowCommand;
use Mata\Cli\Command\DoctorCommand;
use Mata\Cli\Command\Events\EventsListCommand;
use Mata\Cli\Command\Events\EventsShowCommand;
use Mata\Cli\Command\Libraries\LibrariesListCommand;
use Mata\Cli\Command\Logs\LogsFilesCommand;
use Mata\Cli\Command\Logs\LogsShowCommand;
use Mata\Cli\Command\Metrics\MetricsSeriesCommand;
use Mata\Cli\Command\Metrics\MetricsStatusCommand;
use Mata\Cli\Command\Migrate\MigrateCheckCommand;
use Mata\Cli\Command\Migrate\MigrateDownCommand;
use Mata\Cli\Command\Migrate\MigrateStatusCommand;
use Mata\Cli\Command\Migrate\MigrateUpCommand;
use Mata\Cli\Command\Processes\ProcessesShowCommand;
use Mata\Cli\Command\Server\ServerAddCommand;
use Mata\Cli\Command\Server\ServerInfoCommand;
use Mata\Cli\Command\Server\ServerListCommand;
use Mata\Cli\Command\Server\ServerRemoveCommand;
use Mata\Cli\Command\Server\ServerShowCommand;
use Mata\Cli\Command\Server\ServerTestCommand;
use Mata\Cli\Command\StatusCommand;
use Mata\Cli\Command\User\UserCreateCommand;
use Mata\Cli\Command\User\UserDeleteCommand;
use Mata\Cli\Command\User\UserListCommand;
use Mata\Cli\Command\User\UserPasswdCommand;
use Mata\Cli\Command\User\UserUnlockCommand;
use Mata\Config\Dto\NodeApiConfig;
use Mata\Config\Monitoring\ServersConfigEditor;
use Mata\Config\Validation\ConfigValidator;
use Mata\Services\Monitor\HttpProbeClient;
use Mata\Services\Monitor\NodeConnectionTester;
use Mata\Utils\AppVersion;
use Mata\Utils\PathResolver;
use Symfony\Component\Console\Input\ArgvInput;

require_once __DIR__ . '/../vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// Root would read files the web server cannot and create cache files the web app cannot overwrite.
if (function_exists('posix_geteuid') && posix_geteuid() === 0 && getenv('MATA_ALLOW_ROOT') !== '1') {
    fwrite(STDERR, "Refusing to run as root. Run as the web server user (server add/remove: as the owner of config/), e.g.\n"
        . "  docker exec -u www-data mata-dashboard-web php bin/mata …\n"
        . "  sudo -u www-data php bin/mata …   (http on Arch, apache on RHEL)\n"
        . "Set MATA_ALLOW_ROOT=1 to override.\n");

    exit(2);
}

// Like the app, every command uses config/; point it elsewhere with a symlink. Only
// `config validate --path` reads another directory, e.g. a config repo pre-commit hook.
$paths = PathResolver::fromAppPath(dirname(__DIR__));
$cli = new CliConfig($paths);

$serversEditor = new ServersConfigEditor($cli->configPath);
$connectionTester = new NodeConnectionTester(new HttpProbeClient(), NodeApiConfig::DEFAULT_TIMEOUT_SECONDS);

$application = new CliApplication('mata dashboard', static fn (): ?string => AppVersion::detect($paths->appPath));
$application->addCommands([
    new ConfigValidateCommand(new ConfigValidator(), $cli->configPath),
    new ServerListCommand($serversEditor),
    new ServerAddCommand($serversEditor, $connectionTester),
    new ServerTestCommand($serversEditor, $connectionTester),
    new ServerRemoveCommand($serversEditor),
    new StatusCommand($cli),
    new UserListCommand($cli),
    new UserCreateCommand($cli),
    new UserPasswdCommand($cli),
    new UserUnlockCommand($cli),
    new UserDeleteCommand($cli),
    new MigrateStatusCommand($cli),
    new MigrateUpCommand($cli),
    new MigrateDownCommand($cli),
    new MigrateCheckCommand($cli),
    new MetricsStatusCommand($cli),
    new DoctorCommand($cli),
    new AlarmTestCommand($cli),
    new AlarmExplainCommand($cli),
    new AdvisorySourcesCommand($cli),
    new AdvisoryFetchCommand($cli),
    new AdvisoryReportCommand($cli),
    // Read-only data for operators and agents
    new ServerShowCommand($cli),
    new ServerInfoCommand($cli),
    new AppsListCommand($cli),
    new AppsSessionsCommand($cli),
    new AppsReadmeCommand($cli),
    new LogsShowCommand($cli),
    new LogsFilesCommand($cli),
    new ProcessesShowCommand($cli),
    new CronjobsShowCommand($cli),
    new LibrariesListCommand($cli),
    new AuditShowCommand($cli),
    new DbShowCommand($cli),
    new DbProcessesCommand($cli),
    new EventsListCommand($cli),
    new EventsShowCommand($cli),
    new AlarmsListCommand($cli),
    new MetricsSeriesCommand($cli),
]);

// The CLI SAPI fills argv with strings; filtering only narrows the type for PHPStan.
$argv = array_values(array_filter($_SERVER['argv'] ?? [], 'is_string'));

// Accept `mata config validate` as well as Symfony's `mata config:validate`.
if (isset($argv[1], $argv[2]) && $application->has("{$argv[1]}:{$argv[2]}")) {
    array_splice($argv, 1, 2, ["{$argv[1]}:{$argv[2]}"]);
}

$input = new ArgvInput($argv);
// Never prompt when an agent or script drives the CLI; commands then need --yes.
if (!stream_isatty(STDIN)) {
    $input->setInteractive(false);
}

exit($application->run($input));

# Development files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files and caches
temp/
logs/

# Production database (default DATA_PATH), owned by the mysql container
data/
*.log
*.tmp

# Composer vendor directory (installed in container)
vendor/

# Environment and instance configuration (mounted at runtime, may be its own git repo)
.env
.env.*
!.env.example
config

# Git files
.git/
.gitignore
.gitmodules

# Apache .htaccess (not needed in Docker, uses vhost config)
.htaccess
public/.htaccess

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation and development files
README.md
CHANGELOG.md
CONTRIBUTING.md
TODO.md

# Test files
src/Tests/
tests/
phpunit.xml
phpunit.xml.dist
.phpunit.cache
.phpunit.result.cache
coverage/

# Static analysis and code quality
phpstan.neon
ruleset.xml
.phpcs.xml

# Build and development tools
package.json
package-lock.json

# Trash and backup files
trash/
*.bak
*.backup

# Docker files (to avoid recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.gitlab-ci.yml
.travis.yml
.github/
Jenkinsfile

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db